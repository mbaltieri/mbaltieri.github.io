---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Button from '~/components/ui/Button.astro';
import ResearchFields from '~/components/widgets/ResearchFields.astro';
import type { ResearchField, ResearchQuestion } from '~/components/widgets/ResearchFields.astro';
import { getPermalink } from '~/utils/permalinks';
import { findPublication, publicationLinks } from '~/utils/publications';
import { inlineMarkdown } from '~/utils/markdown';

const metadata = {
  title: 'Research',
  description:
    "Manuel Baltieri's research on mathematical foundations of agency, cognition, artificial life, and AI safety in agent-environment systems.",
};

// The papers of a question, by their titles in src/data/publications.yaml. A title that is not
// there stops the build.
const papers = (titles: Array<string>) =>
  titles.map((title) => {
    const pub = findPublication(title);
    if (!pub) throw new Error(`Not in src/data/publications.yaml: "${title}"`);
    return { title: pub.title, href: publicationLinks(pub)[0]?.href, venue: pub.venue, year: pub.year };
  });

// A question of an area: its answer is written in Markdown, a paragraph per item.
const question = async ({
  answer,
  aside,
  papers: titles = [],
  ...rest
}: Omit<ResearchQuestion, 'answer' | 'aside' | 'papers'> & {
  answer: Array<string>;
  aside?: string;
  papers?: Array<string>;
}): Promise<ResearchQuestion> => ({
  ...rest,
  answer: await Promise.all(answer.map((paragraph) => inlineMarkdown(paragraph))),
  aside: aside ? await inlineMarkdown(aside) : undefined,
  papers: papers(titles),
});

// The areas, each with the questions it takes up. The questions come from the former Projects
// and Vision pages, whose addresses now lead to them (astro.config.ts).
const fields: Array<ResearchField> = [
  {
    id: 'mathematics-of-agents',
    number: '01',
    name: 'Maths',
    keywords: 'Category theory, control, probability',
    title: 'Mathematics for agents',
    text: 'Different mathematical languages reveal different aspects of agency. Category theory describes systems and processes, their compositional patterns and universal properties. Control theory formalises feedback and regulation, while Bayesian inference captures uncertainty and learning patterns.',
    questions: [
      await question({
        id: 'theories-of-agency',
        label: 'Theories of agency',
        question: 'How do we go from simple physics to agency?',
        answer: [
          'Agency is central to biology, cognitive science and AI, yet no widely accepted formal definition of agency or purpose exists. Agency is usually tied to the idea of a system able to take an action, without saying what an action is: is a ball taking an action when it falls to the ground, or when someone bounces it on a court?',
          'Goals are often assumed simply to exist, without saying whether they are intrinsic properties of a system or attributed to it by an observer, or whether the same system can have different goals depending on who looks at it. A framework for these questions is being built on categorical systems theory (see [David Jaz Myers’ draft book](http://davidjaz.com/Papers/DynamicalBook.pdf) and [Matteo Capucci’s notes](https://github.com/mattecapu/categorical-systems-theory)).',
        ],
        papers: ['Mathematical approaches to the study of agents'],
        links: [
          { text: 'Lecture 1, Defining agency (PDF)', href: '/assets/pdf/presentations/Lecture1_Baltieri.pdf' },
          {
            text: 'Lecture 2, A history of studies of agency (PDF)',
            href: '/assets/pdf/presentations/Lecture2_Baltieri.pdf',
          },
          {
            text: 'Lecture 3, First-principles definitions of agents (PDF)',
            href: '/assets/pdf/presentations/Lecture3_Baltieri.pdf',
          },
        ],
        linksNote:
          'Lectures for the CHAIN Winter School on Minimal Cognition and Agency, Hokkaido University, February 2023.',
      }),
      await question({
        id: 'agents-life-and-cognition',
        label: 'Agents, life and cognition',
        question:
          'Are there sharp lines between agents and non-agents, the living and the non-living, the cognitive and the non-cognitive?',
        answer: [
          'Formal definitions of agency, life and cognition come down to what separates agentic from non-agentic systems, living from non-living organisms, and cognitive from non-cognitive architectures. Do sharp distinctions between these classes exist, and are they meaningful? If there are none, why are some systems perceived to be qualitatively different? And what mathematical theories can bring out such apparent diversity?',
        ],
        drawing: 'fundamental-questions',
      }),
      await question({
        id: 'agents-and-observers',
        label: 'Agents and observers',
        question: 'What is the difference between an observer and an agent?',
        answer: [
          'The frameworks used to study life and cognition, from information theory, control theory and dynamical systems to (stochastic) thermodynamics and (applied) category theory, all give observers a fundamental role: entropy in information theory and thermodynamics, observability in dynamical systems, the very definition of a target state in control theory. Can observers be defined in a way that unifies these notions? Can observers not be agents? Is agency in the eye of the beholder, or an intrinsic property of a system?',
          'Autopoietic proposals in theoretical biology and Bayesian frameworks in cognitive science suggest further questions. Can intrinsic goals explain living and cognitive organisms without observers? What does it mean for an agent to be autonomous? Can non-agents become agents, and can non-agentic parts be composed into one?',
        ],
        aside:
          'Unpopular opinion: the concept of agency captures *mostly* just a series of choices made by an observer (cf. intentional stance). Less unpopular opinion: an interesting definition of agency could arise from the use of the word “mostly” in the line above.',
        drawing: 'agents-and-observers',
      }),
    ],
  },
  {
    id: 'cognition-and-control',
    number: '02',
    name: 'Cognition',
    keywords: 'Inference, control, representations',
    title: 'Cognition and control',
    text: 'Perception, action, and minimal cognition are studied with control theory, Bayesian reasoning, and dynamical systems. This includes examining when a controller can be said to contain an internal model and how causal representations support adaptive behaviour in natural and artificial agents.',
    questions: [
      await question({
        id: 'internal-model-principle',
        label: 'Internal models and good regulators',
        question: 'When does a system that regulates its environment contain a model of it?',
        answer: [
          'Conant and Ashby claimed that “every good regulator of a system must be a model of that system”, an idea taken up in control theory as the internal model principle. When can a system that regulates its environment be said to model it, and how do such models relate to the Bayesian models of cognitive science?',
          'A Bayesian interpretation of the internal model principle formulates it in categorical systems theory and shows that its notion of model is a special case of possibilistic Bayesian filtering ([a longer summary](/news/2025-03-01-bayesian-IMP/)). A “good regulator theorem” for embodied agents shows that whenever an agent can perform a regulation task, an observer can interpret it as having beliefs about its environment, updated in response to sensory input. The universal property of possibilistic belief updating shows that the agent’s ability to perform the task and the map from its states to beliefs are the same thing.',
        ],
        papers: [
          'A Bayesian Interpretation of the Internal Model Principle',
          'A "good regulator theorem" for embodied agents',
          'The Universal Property of Possibilistic Belief Updating',
        ],
      }),
      await question({
        id: 'causality',
        label: 'Causality',
        question: 'How do natural and artificial agents acquire and use causal information?',
        answer: [
          'Causal cognition is the ability to acquire and exploit causal information about oneself and the world. Research on causal cognition in human and non-human animals meets causal machine and reinforcement learning, with disentanglement as a candidate process for building causal representations. A unifying computational framework organises causal cognition by its explicitness, sources and integration, and identifies explicitness with disentanglement ([a longer summary](/news/2024-11-25-distentangled-representations/)).',
        ],
        papers: [
          'Disentangled Representations for Causal Cognition',
          'Ecological causal cognition needs disentanglement: Reply to comments on "Disentangled representations for causal cognition"',
        ],
      }),
      await question({
        id: 'uncertainty',
        label: 'Uncertainty',
        question: 'How do agents decide when they cannot know precisely what is happening around them?',
        answer: [
          'Behaviour and decision making depend on the uncertainty an agent has about its environment, a dynamic system with too many properties to keep track of. How is an agent affected by unknown and ambiguous information, and how can reliable behaviour emerge from uncertain stimuli? Work at the University of Sussex and RIKEN CBS combined behavioural and theoretical studies, mapping experiments onto models of uncertainty from estimation and control theory, psychology, neuroscience and biology, from Kalman filters to PID control and the delta rule.',
        ],
      }),
      await question({
        id: 'origins-of-cognition',
        label: 'Origins of cognition',
        question: 'Where does cognition come from, and what is its evolutionary role?',
        answer: [
          'Models of minimal cognition, and of action and perception in coupled agent–environment systems, are the usual setting. Earlier work combined the uncertainty of information and estimation theory with time-evolving trajectories and the geometry of phase spaces in dynamical systems. More recent work looks at models of policy selection and decision making inspired by time-reversal symmetry in stochastic thermodynamics (detailed balance, zero entropy production).',
        ],
        aside: 'Generally: somewhat unsure about (but attracted by the idea of) a life–mind continuity thesis.',
        drawing: 'origins-of-cognition',
      }),
    ],
  },
  {
    id: 'artificial-life',
    number: '03',
    name: 'Artificial Life',
    keywords: 'Autonomy, regulation, organisation',
    title: 'Artificial life',
    text: 'Research on living systems sharpens questions about autonomy, individuality and regulation. The focus is on whether concepts from cybernetics, information and control theory can explain what separates living from non-living systems.',
    questions: [
      await question({
        id: 'hybrid-life',
        label: 'Hybrid life',
        question: 'How can biological, artificial and cognitive systems be studied together?',
        answer: [
          'Hybrid Life, a special session of the annual ALIFE conference since 2018, looks at artificial life from three perspectives: unified formal languages for living, artificial and cognitive systems (control theory, Bayesian inference, dynamical systems), biological systems enhanced with artificial parts to probe the moving boundaries between living and non-living (bio-inspired robotics, human augmentation, synthetic biology), and coupled heterogeneous systems, from human–computer interaction to virtual and augmented reality.',
        ],
        papers: ['Hybrid Life: Integrating Biological, Artificial, and Cognitive Systems'],
        links: [{ text: 'The Hybrid Life special sessions', href: 'https://sites.google.com/view/hybridlife' }],
      }),
      await question({
        id: 'origins-of-life',
        label: 'Origins of life',
        question: 'Is homeostasis enough to tell the living from the non-living?',
        answer: [
          'A short stay at EON, the ELSI Origins of Life Network at Tokyo Tech, led to work on theories of the origins of life, especially those linking them to information and control theory. Does control theory provide the right language for homeostasis? Can information theory give a useful, intrinsic notion of information for living systems, one that captures autopoiesis beyond simple homeostasis? Can these ideas be grounded in thermodynamics, towards a statistical mechanics of living systems?',
        ],
        links: [
          {
            text: 'Information and regulation at the origins of life, for EON',
            href: 'https://web.archive.org/web/20230117062811/https://eon.elsi.jp/information-and-regulation-at-the-origins-of-life/',
          },
        ],
        drawing: 'origins-of-life',
      }),
    ],
    papers: papers(['A Braitenberg vehicle’s habitat']),
  },
  {
    id: 'agent-foundations-for-ai-safety',
    number: '04',
    name: 'AI safety',
    keywords: 'Agent foundations, abstractions, capabilities',
    title: 'Agent foundations',
    text: 'Formal foundations are being developed for identifying AI agents in and among modern AI systems, together with their boundaries, goals and models, in order to estimate their capabilities and improve interpretability. The aim is to make safety questions precise enough to analyse and test.',
    questions: [
      await question({
        id: 'physical-and-intentional-stance',
        label: 'Physical and intentional stance',
        question: 'When can a dynamical system be understood as a goal-directed agent?',
        answer: [
          'A formal link is being developed between the physical behaviour of a system and an intentional description in terms of beliefs and goals. Mathematical interpretation maps ask when dynamical systems can be understood as goal-directed agents, and how this can support tools for checking whether AI behaviour is consistent with its intended purpose. The project (2025–2027) is supported by ARIA’s *Trust Everything, Everywhere* opportunity space.',
        ],
        papers: [
          'Bayesian updates from coalgebraic determinisation',
          'The Universal Property of Possibilistic Belief Updating',
        ],
        links: [
          {
            text: 'Combining Physical and Intentional Stance for Safe AI, at ARIA',
            href: 'https://aria.org.uk/opportunity-spaces/trust-everything-everywhere/opportunity-seeds?tabId=nora-portfolio&cardId=combining-physical-intentional-stance-safe-ai',
          },
        ],
      }),
      await question({
        id: 'world-models',
        label: 'World models',
        question: 'What do world models need to contain, and what are they models of?',
        answer: [
          'World models are central to model-based reinforcement learning, and have been proposed as sandboxes in which AI agents can be tested before deployment. There is a fundamental trade-off between their efficiency and their interpretability. A large world model, represented as a transducer, can be decomposed into interacting modules for parallelisable, interpretable and distributed inference. Behavioural structures can be specified compositionally, from local, one-step descriptions of dynamics, and transferred safely between abstract and concrete systems. And world models can be told apart by the channel they model: the environment, the agent, or their joint process.',
        ],
        papers: [
          'AI in a vat: Fundamental limits of efficient world modelling for agent sandboxing and interpretability',
          'From monoliths to modules: Decomposing transducers for efficient world modelling',
          'Compositional Behavioral Semantics for State Abstraction in Reinforcement Learning',
          'World models of environment, agent and joint agent-environment systems',
        ],
      }),
      await question({
        id: 'boundaries',
        label: 'Boundaries',
        question: 'Where does a boundary come from?',
        answer: [
          'In categorical systems theory an agent and its environment interact through a fixed interface. When boundaries change, interfaces change with them, and it becomes unclear how an agent’s identity is preserved. A critique of Markov blankets looked at how they came to be used to define the boundary between an agent and its environment ([a longer summary](/news/2021-01-09-friston-blankets/)). Boundaries are also a direction for AI safety research, with workshops on conceptual and on mathematical models of boundaries.',
        ],
        papers: [
          'The Emperor’s New Markov Blankets',
          'The Emperor is Naked: Replies to the commentaries on the target article.',
        ],
        links: [
          { text: 'Conceptual Boundaries Workshop, Austin, February 2024', href: 'https://formalizingboundaries.ai' },
          {
            text: 'Mathematical Boundaries Workshop, Berkeley, April 2024 (a retrospective)',
            href: 'https://www.lesswrong.com/posts/NitP3AsMeuycJQbfa/retrospective-on-mathematical-boundaries-workshop',
          },
        ],
      }),
    ],
  },
];
---

<Layout metadata={metadata}>
  <HeroText title="Research">
    <Fragment slot="subtitle">
      <span class="block text-xl md:text-2xl text-heading">
        Studying how agents can be identified, modelled, and composed, and what those formal choices imply for
        cognition, living systems, and AI safety.
      </span>
      <span class="block mt-4">
        Manuel focuses on coupled open agent–environment systems that compose to form autonomous systems. This makes it
        possible to ask where a boundary comes from, what counts as a model or a goal, and which properties belong to a
        system rather than to the observer describing it.
      </span>
    </Fragment>
    <div slot="content" class="mt-2 flex flex-wrap justify-center gap-3 print:hidden">
      <Button variant="primary" text="Publications" href={getPermalink('/research/publications')} />
      <Button text="Talks" href={getPermalink('/research/talks')} />
    </div>
  </HeroText>

  <ResearchFields
    label="Areas of research: mathematics, cognition, artificial life and AI safety"
    fields={fields}
    classes={{ container: 'pt-8 md:pt-10 lg:pt-12' }}
  />
</Layout>
