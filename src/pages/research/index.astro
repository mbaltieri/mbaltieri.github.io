---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ResearchFields from '~/components/widgets/ResearchFields.astro';
import type { ResearchField, ResearchQuestion } from '~/components/widgets/ResearchFields.astro';
import { findPublication, publicationLinks, publications } from '~/utils/publications';
import { inlineMarkdown } from '~/utils/markdown';
import { research, areaDrawings, answerDrawings } from '~/utils/research';
import type { ResearchQuestionEntry } from '~/utils/research';

const metadata = {
  title: 'Research programme',
  description:
    "Manuel Baltieri's research on control, cognition, artificial life, and AI safety in agent-environment systems.",
  openGraph: { images: [{ url: '~/assets/images/social/research.jpg' }] },
};

// The papers of a question (or an area's other papers), by their titles in
// src/data/publications.yaml, newest first in the order of the Publications page, whatever the order
// they are listed in. A title that is not there stops the build.
const papers = (titles: Array<string>) =>
  titles
    .map((title) => {
      const pub = findPublication(title);
      if (!pub) throw new Error(`Not in src/data/publications.yaml: "${title}"`);
      return pub;
    })
    .sort((a, b) => publications.indexOf(a) - publications.indexOf(b))
    .map((pub) => ({ title: pub.title, href: publicationLinks(pub)[0]?.href, venue: pub.venue, year: pub.year }));

// A question of an area, as written in src/data/research.yaml: its answer and aside are Markdown,
// its papers are titles, and its drawing is one of VisionGraphic's.
const question = async ({
  answer,
  aside,
  papers: titles = [],
  drawing,
  ...rest
}: ResearchQuestionEntry): Promise<ResearchQuestion> => {
  if (drawing && !(answerDrawings as ReadonlyArray<string>).includes(drawing))
    throw new Error(`src/data/research.yaml: no drawing "${drawing}", only ${answerDrawings.join(', ')}`);
  return {
    ...rest,
    answer: await Promise.all(answer.map((paragraph) => inlineMarkdown(paragraph))),
    aside: aside ? await inlineMarkdown(aside) : undefined,
    papers: papers(titles),
    drawing: drawing as ResearchQuestion['drawing'],
  };
};

// The areas, each with the questions it takes up, from src/data/research.yaml.
const fields: Array<ResearchField> = await Promise.all(
  research.map(async ({ id, questions, papers: titles, ...area }) => {
    if (!(areaDrawings as ReadonlyArray<string>).includes(id))
      throw new Error(`src/data/research.yaml: no area "${id}", only ${areaDrawings.join(', ')}`);
    return {
      ...area,
      id: id as ResearchField['id'],
      questions: await Promise.all(questions.map(question)),
      papers: titles ? papers(titles) : undefined,
    };
  })
);
---

<Layout metadata={metadata}>
  <HeroText title="Research programme">
    <Fragment slot="subtitle">
      <span class="block text-xl md:text-2xl text-heading">
        Studying how agents can be identified, modelled, and composed, and what those formal choices imply for
        cognition, living systems, and AI safety.
      </span>
    </Fragment>
  </HeroText>

  <ResearchFields
    label="Areas of research: control, cognition, artificial life and AI safety"
    fields={fields}
    classes={{ container: 'pt-8 md:pt-10 lg:pt-12' }}
  />
</Layout>
