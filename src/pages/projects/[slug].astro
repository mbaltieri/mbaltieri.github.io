---
import type { GetStaticPaths, ImageMetadata, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import PublicationsByTitle from '~/components/publications/PublicationsByTitle.astro';
import { fetchProjects, getProjectPermalink } from '~/utils/projects';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { truncateAtWord } from '~/utils/utils';
import type { MetaData } from '~/types';

export const getStaticPaths = (async () =>
  (await fetchProjects()).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props as Props;
const { title, description, image: imagePath, imageAlt, papers = [] } = project.data;
const { Content } = await render(project);

const image = (await findImage(imagePath)) as ImageMetadata | string | undefined;

const metadata: MetaData = {
  title,
  description: truncateAtWord(description, 155),
  canonical: String(getCanonical(getProjectPermalink(project))),
  openGraph: image
    ? {
        images: [
          {
            url: imagePath as string,
            width: (image as ImageMetadata)?.width,
            height: (image as ImageMetadata)?.height,
          },
        ],
      }
    : {},
  ...project.data.metadata,
};

const breadcrumbs = [
  { text: 'Home', href: getPermalink('/') },
  { text: 'Projects', href: getPermalink('/projects') },
  { text: title },
];
---

<Layout metadata={metadata}>
  <Breadcrumbs bar hideCurrent items={breadcrumbs} />
  <section class="py-8 sm:py-16 lg:py-20 mx-auto">
    <article>
      <header>
        <h1
          class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
        >
          {title}
        </h1>
        {
          description && (
            <p class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-xl md:text-2xl text-muted dark:text-slate-400 text-pretty">
              {description}
            </p>
          )
        }
        {
          image && (
            <Image
              src={image}
              class="max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700"
              widths={[400, 900]}
              sizes="(max-width: 900px) 400px, 900px"
              alt={imageAlt || ''}
              width={900}
              height={506}
              format="webp"
              loading="eager"
              decoding="async"
            />
          )
        }
      </header>
      <div
        class="mx-auto px-6 sm:px-6 max-w-3xl prose lg:prose-xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-primary prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0"
      >
        <Content />
      </div>
      {
        papers.length > 0 && (
          <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-12">
            <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-tighter text-heading">Papers</h2>
            <PublicationsByTitle titles={papers} />
          </div>
        )
      }
    </article>
  </section>
  <div class="mx-auto px-6 sm:px-6 max-w-3xl pt-8 md:pt-4 pb-12 md:pb-20">
    <Button variant="tertiary" class="px-3 md:px-3" href={getPermalink('/projects')}>
      <Icon name="tabler:chevron-left" class="w-5 h-5 mr-1 -ml-1.5 rtl:-mr-1.5 rtl:ml-1 rtl:rotate-180" /> All projects
    </Button>
  </div>
</Layout>
