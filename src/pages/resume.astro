---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Timeline from '~/components/ui/Timeline.astro';
import PublicationEntry from '~/components/publications/PublicationEntry.astro';
import { resume, resumeDates } from '~/utils/resume';
import { publications } from '~/utils/publications';
import { getPermalink } from '~/utils/permalinks';
import { escapeHtml, inlineMarkdown } from '~/utils/markdown';

// A resume built from AstroWind's own pieces: its banner for the header, its Timeline for the
// positions, and the entries of the Publications page for the papers. Everything comes from
// src/data/resume.yaml, except the selected publications, which come from
// src/data/publications.yaml. The full CV is the button beside the heading of the profile. The
// contact details, the location, the service roles, the languages and the interests are left off
// the page. They stay in the data, so they are still in /assets/resume.json.

const metadata = {
  title: 'Resume',
  description: "Manuel Baltieri's resume: positions, education, selected publications and skills.",
  openGraph: { images: [{ url: '~/assets/images/social/resume.jpg' }] },
};

const { basics, work = [], education = [], skills = [] } = resume;

// The summary is a list of short statements in the data, shown side by side.
const statementIcons = ['tabler:atom-2', 'tabler:math-function', 'tabler:code'];
const statements = await Promise.all(
  (basics.summary ?? '')
    .split(/\n+/)
    .map((line) => line.replace(/^\s*-\s*/, '').trim())
    .filter(Boolean)
    .map((line) => inlineMarkdown(line))
);

// Each position: the role and its dates on one line, the organisation under it, then what it was.
const organisation = (name: string, href?: string) =>
  href
    ? `<a class="hover:text-primary hover:underline" href="${escapeHtml(href)}">${escapeHtml(name)}</a>`
    : escapeHtml(name);
const positions = await Promise.all(
  work.map(async (job) => ({
    title: `<span class="flex flex-wrap items-baseline justify-between gap-x-4"><span>${escapeHtml(job.position)}</span><span class="text-sm font-normal tabular-nums text-muted">${resumeDates(job.startDate, job.endDate)}</span></span><span class="mt-0.5 block text-base font-normal text-muted">${organisation(job.company, job.website)}</span>`,
    description: job.summary ? await inlineMarkdown(job.summary) : undefined,
  }))
);

const selected = publications.filter((entry) => entry.selected);

const section =
  'scroll-mt-24 pt-12 md:pt-16 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade';
// A section's heading, with a rule to the end of the line.
const rule =
  'flex items-center gap-4 font-heading text-2xl font-semibold text-heading after:h-px after:flex-1 after:bg-gray-200 dark:after:bg-slate-800';
const heading = `mb-6 ${rule}`;
---

<Layout metadata={metadata}>
  <HeroText title="Resume">
    <Fragment slot="subtitle">
      <span class="block text-xl md:text-2xl text-heading">{basics.label}</span>
    </Fragment>
  </HeroText>

  <div class="mx-auto max-w-4xl px-4 pb-16 md:px-6 md:pb-20">
    <section id="profile" class={section}>
      <div class="mb-6 flex items-center gap-4">
        <h2 class={`flex-1 ${rule}`}>Profile</h2>
        <a
          class="inline-flex items-center gap-1.5 rounded-full bg-primary px-4 py-1.5 text-sm font-semibold text-white transition hover:bg-secondary dark:text-[var(--aw-color-bg-page)]"
          href="/assets/Academic_CV.pdf"
        >
          Full CV
          <Icon name="tabler:file-type-pdf" class="h-4 w-4" />
        </a>
      </div>
      <ul class="grid gap-6 md:grid-cols-3">
        {
          statements.map((statement, index) => (
            <li class="flex gap-3">
              <Icon name={statementIcons[index % statementIcons.length]} class="mt-0.5 h-6 w-6 shrink-0 text-primary" />
              <p class="text-default" set:html={statement} />
            </li>
          ))
        }
      </ul>
    </section>

    <section id="experience" class={section}>
      <h2 class={heading}>Experience</h2>
      <Timeline
        items={positions}
        defaultIcon="tabler:point-filled"
        classes={{
          title: 'text-lg font-semibold text-heading',
          description: 'mt-1.5 text-sm',
          icon: 'h-6 w-6 p-1 border text-primary border-primary/40 dark:border-primary/60',
          // The text column fills the line, so that the dates sit at its right end.
          panel: '[&>div:last-child]:flex-1',
        }}
      />
    </section>

    <section id="education" class={section}>
      <h2 class={heading}>Education</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-gray-200 text-xs uppercase tracking-wide text-muted dark:border-slate-800">
              <th scope="col" class="py-2 pr-4 font-semibold">Degree</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Field</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Institution</th>
              <th scope="col" class="py-2 font-semibold whitespace-nowrap">Dates</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-slate-800">
            {
              education.map((school) => (
                <tr>
                  <td class="py-3 pr-4 font-semibold text-heading">{school.studyType}</td>
                  <td class="py-3 pr-4 text-default">{school.area}</td>
                  <td class="py-3 pr-4 text-muted">{school.institution}</td>
                  <td class="py-3 whitespace-nowrap tabular-nums text-muted">
                    {resumeDates(school.startDate, school.endDate)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section id="publications" class={section}>
      <h2 class={heading}>Selected publications</h2>
      <ol class="divide-y divide-gray-200 dark:divide-slate-800">
        {selected.map((pub) => <PublicationEntry pub={pub} />)}
      </ol>
      <p class="mt-4">
        <a class="font-medium text-primary hover:underline" href={getPermalink('/research/publications')}>
          All publications
        </a>
      </p>
    </section>

    <section id="skills" class={section}>
      <h2 class={heading}>Skills</h2>
      <dl class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
        {
          skills.map((skill) => (
            <div>
              <dt class="font-heading text-lg font-semibold text-heading">{skill.name}</dt>
              <dd class="mt-2 flex flex-wrap gap-1.5">
                {(skill.keywords ?? []).map((keyword) => (
                  <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-sm text-default dark:bg-primary/15">
                    {keyword}
                  </span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</Layout>
