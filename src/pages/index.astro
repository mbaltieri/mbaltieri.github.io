---
import Layout from '~/layouts/PageLayout.astro';

import HeroVehicles from '~/components/widgets/HeroVehicles.astro';
import AgentEnvironment from '~/components/widgets/AgentEnvironment.astro';
import FeatureTabs from '~/components/widgets/FeatureTabs.astro';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
import { getPermalink } from '~/utils/permalinks';
import { resume } from '~/utils/resume';
import { paperPages } from '~/utils/papers';

const metadata = {
  title: SITE?.name,
  ignoreTitleTemplate: true,
  openGraph: { images: [{ url: '~/assets/images/social/home.jpg' }] },
};

// The site and its owner, for search engines. The profile links are those of src/data/resume.yaml.
const personId = `${SITE?.site}/#person`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': personId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: resume.basics.name,
    url: SITE?.site,
    ...(resume.basics.picture ? { image: new URL(resume.basics.picture, SITE?.site).toString() } : {}),
    sameAs: (resume.basics.profiles ?? []).map((profile) => profile.url),
  },
];

const link = (text: string, href: string) => `<a class="text-primary hover:underline" href="${href}">${text}</a>`;

// The questions of the research agenda.
const questions = [
  'Where does a boundary come from?',
  'What counts as a model or a goal?',
  'Which properties belong to a system rather than to the observer describing it?',
];

// A few talks, the newest first after the one in Oxford, which leads. Each has a preview: the
// thumbnail of its recording when there is one (kept in src/assets/images/talks/, so that the page loads
// nothing from YouTube), or else the first slide of its deck.
const talks = [
  {
    title: 'Life and its relatives',
    event: 'Breakthrough Initiatives, Oxford',
    when: 'April 2025',
    preview: '~/assets/images/talks/youtube--wuzt7JgRuM.jpg',
    recording: 'https://www.youtube.com/watch?v=-wuzt7JgRuM',
    slides: '/assets/pdf/presentations/BreakthroughInitiatives2025.pdf',
  },
  {
    title: 'From Life to Artificial Agents: How Do We “Mathematise” Agency?',
    event: 'Università IULM, Milan',
    when: 'February 2026',
    preview: '~/assets/images/talks/slides-mathematise-agency.jpg',
    slides: '/assets/pdf/presentations/IULM.pdf',
  },
  {
    title: 'Proving AI safety: Mathematical foundations of AI safety',
    event: 'AIRJ Symposium 2025, Embassy of Italy, Tokyo',
    when: 'November 2025',
    preview: '~/assets/images/talks/slides-proving-ai-safety.jpg',
    slides: '/assets/pdf/presentations/AISafety2025.pdf',
  },
  {
    title: 'The Role of the Free Energy Principle in AI Safety: Markov Blankets and Beyond',
    event: 'Technical AI Safety Conference, Tokyo',
    when: 'April 2024',
    preview: '~/assets/images/talks/youtube-qYyzdOEGNIM.jpg',
    recording: 'https://www.youtube.com/watch?v=qYyzdOEGNIM',
    slides: '/assets/pdf/presentations/TAIS2024.pdf',
  },
  {
    title: 'Inference with and within a model',
    event: 'CHAIN Academic Seminars, Hokkaido University, Sapporo',
    when: 'February 2023',
    preview: '~/assets/images/talks/youtube-yA-d1atSzWs.jpg',
    recording: 'https://www.youtube.com/watch?v=yA-d1atSzWs',
    slides: '/assets/pdf/presentations/CC_Tokyo.pdf',
  },
];

const selectedWork = [
  {
    title: 'Mathematical approaches to the study of agents',
    description: 'A review of mathematical approaches to studying agents across research fields.',
    icon: 'tabler:math-function',
    caption: 'Philosophical Transactions of the Royal Society B · 2026, to appear',
    callToAction: { text: 'Read the preprint', href: 'https://osf.io/rqu7s_v2' },
    paper: paperPages('mathematical-approaches'),
  },
  {
    title: 'Disentangled representations for causal cognition',
    description:
      'Relating causal representation learning to how natural and artificial agents acquire causal knowledge.',
    icon: 'tabler:brain',
    caption: 'Physics of Life Reviews · 2024',
    callToAction: { text: 'Read the paper', href: '/assets/pdf/DisentanglementCausalCognition.pdf' },
    paper: paperPages('disentangled-representations'),
  },
  {
    title: 'Hybrid Life: Integrating Biological, Artificial, and Cognitive Systems',
    description:
      'A synthesis of biological, artificial, and cognitive perspectives on life and the formal languages that can connect them.',
    icon: 'tabler:plant-2',
    caption: 'WIREs Cognitive Science · 2023',
    callToAction: { text: 'Read the paper', href: '/assets/pdf/HybridLifeWIREs.pdf' },
    paper: paperPages('hybrid-life'),
  },
  {
    title: 'Compositional Behavioral Semantics for State Abstraction in Reinforcement Learning',
    description:
      'A unified framework for behavioural structures in reinforcement learning and their safe transfer between abstract and concrete systems.',
    icon: 'tabler:shield-check',
    caption: 'International Conference on Machine Learning (ICML) · 2026',
    callToAction: {
      text: 'Read the paper',
      href: 'https://raw.githubusercontent.com/mlresearch/v306/main/assets/zhang26dy/zhang26dy.pdf',
    },
    paper: paperPages('compositional-behavioral-semantics'),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <HeroVehicles
    title="What does<br />an agent<br />model?"
    subtitle="Manuel develops mathematical theories for understanding agency: how agents are distinguished from their environments, what they model and how they pursue goals, and how these ideas can support safer AI."
    actions={[
      { variant: 'primary', text: 'Explore research', href: getPermalink('/research') },
      { text: 'Resume', href: getPermalink('/resume') },
    ]}
  />

  <WidgetWrapper id="research-agenda" containerClass="max-w-6xl">
    <Headline title="Research agenda" subtitle={link('Research vision', getPermalink('/research'))} />
    <div class="grid gap-10 md:grid-cols-2 md:gap-16">
      <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <p class="font-heading text-2xl md:text-3xl font-medium leading-snug text-heading">
          Studying how agents can be identified, modelled, and composed, and what those formal choices imply for
          cognition, living systems, and AI safety.
        </p>
        <p class="mt-5 text-lg text-muted">
          This research connects category theory, control, probability, dynamical systems, cognitive science, and
          artificial life.
        </p>
      </div>
      <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <p class="text-lg text-muted">
          The focus is on coupled open agent–environment systems that compose to form autonomous systems. This makes it
          possible to ask:
        </p>
        <ul
          class="mt-4 divide-y divide-gray-200 border-y border-gray-200 dark:divide-slate-700 dark:border-slate-700 font-heading text-lg md:text-xl font-medium text-heading"
        >
          {questions.map((text) => <li class="py-3">{text}</li>)}
        </ul>
      </div>
    </div>
    <div class="mt-14 md:mt-16">
      <AgentEnvironment />
    </div>
  </WidgetWrapper>

  <WidgetWrapper id="talks" containerClass="max-w-6xl">
    <Headline title="Selected talks" subtitle={link('All talks', getPermalink('/research/talks'))} />
    <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        talks.map(({ title, event, when, preview, recording, slides }, index) => (
          <li
            class:list={[
              'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
              index === 0 && 'sm:col-span-2 lg:row-span-2',
            ]}
          >
            <a
              class="group relative block aspect-video overflow-hidden rounded-lg bg-gray-300 dark:bg-slate-700"
              href={recording ?? slides}
              tabindex="-1"
              aria-hidden="true"
            >
              <Image
                src={preview}
                alt=""
                class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                layout="cover"
                widths={index === 0 ? [640, 960, 1280] : [320, 480, 640, 960]}
                width={index === 0 ? 1280 : 960}
                height={index === 0 ? 720 : 540}
                sizes={
                  index === 0
                    ? '(max-width: 1023px) 100vw, 560px'
                    : '(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 260px'
                }
                format="webp"
                loading="lazy"
              />
              {recording && (
                <span class="absolute inset-0 flex items-center justify-center bg-black/10 transition group-hover:bg-black/0">
                  <span
                    class:list={[
                      'flex items-center justify-center rounded-full bg-black/60 text-white backdrop-blur-sm',
                      index === 0 ? 'h-16 w-16' : 'h-11 w-11',
                    ]}
                  >
                    <Icon name="tabler:player-play-filled" class={index === 0 ? 'h-7 w-7' : 'h-5 w-5'} />
                  </span>
                </span>
              )}
            </a>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-muted">
              {event} · {when}
            </p>
            <h3
              class:list={[
                'mt-1.5 font-heading font-medium leading-snug text-heading',
                index === 0 ? 'text-2xl' : 'text-lg',
              ]}
            >
              <a class="hover:text-primary transition" href={recording ?? slides}>
                {title}
              </a>
            </h3>
            <p class="mt-2 flex gap-4 text-sm font-medium">
              {recording && (
                <a class="text-primary hover:underline" href={recording}>
                  Recording
                </a>
              )}
              <a class="text-primary hover:underline" href={slides}>
                Slides
              </a>
            </p>
          </li>
        ))
      }
    </ul>
  </WidgetWrapper>

  <FeatureTabs
    id="selected-work"
    title="Selected work"
    subtitle={link('All publications', getPermalink('/research/publications'))}
    items={selectedWork}
    classes={{ container: 'max-w-6xl' }}
  />
</Layout>
