---
import EntryLinks from '~/components/research/EntryLinks.astro';
import type { Talk } from '~/utils/talks';
import { talkDate, talkLinks, talkType } from '~/utils/talks';

// A talk on two lines, laid out like a publication: its title (and a note), then where it was
// given, when and what it was, with "Invited talk" in bold so that invited talks stand out. Its
// links keep the same place as a publication's. Other times it was given, and the parts of a series
// (lectures, with their own links in the same column), follow on lines of their own.

export interface Props {
  talk: Talk;
  /** An id, so that an address can point to the entry. */
  id?: string;
}

const { talk, id } = Astro.props;
const where = (event: string, place?: string) => [event, place].filter(Boolean).join(', ');
const links = talkLinks(talk, talk.kind);
---

<li
  id={id}
  class:list={[
    'grid scroll-mt-24 gap-x-6 gap-y-0.5 py-3 md:items-baseline',
    links.length > 0 && 'md:grid-cols-[minmax(0,1fr)_auto]',
  ]}
>
  <h3 class="font-medium leading-snug text-heading">
    {talk.title ?? talk.event}
    {talk.note && <span class="text-sm font-normal text-muted">{` (${talk.note})`}</span>}
  </h3>
  <p class="text-sm text-muted md:col-span-full">
    {talk.title ? where(talk.event, talk.place) : talk.place} · {talkDate(talk.date)} ·{' '}
    <span class:list={[talk.kind === 'invited' && 'font-semibold text-heading']}>{talkType(talk)}</span>
  </p>
  {
    talk.occasions?.map((occasion) => (
      <p class="text-sm text-muted md:col-span-full">
        Also at {where(occasion.event, occasion.place)} · {talkDate(occasion.date)}
      </p>
    ))
  }
  {
    talk.parts && (
      <ul class="mt-1.5 space-y-1 border-l-2 border-gray-200 pl-3 md:col-span-full dark:border-slate-700">
        {talk.parts.map((part) => (
          <li class="grid gap-x-6 text-sm md:grid-cols-[minmax(0,1fr)_auto] md:items-baseline">
            <span class="text-default">{part.title}</span>
            <EntryLinks links={talkLinks(part)} />
          </li>
        ))}
      </ul>
    )
  }
  <EntryLinks links={links} class="mt-0.5 md:col-start-2 md:row-start-1 md:mt-0" />
</li>
