---
import EntryLinks from '~/components/research/EntryLinks.astro';
import type { Talk } from '~/utils/talks';
import { talkDate, talkLinks, talkType } from '~/utils/talks';

// A talk on two lines, laid out like a publication: its title (and a note) with its links, then
// where it was given, when and what it was, with "Invited talk" in bold so that invited talks stand
// out. Other times it was given, and the parts of a series (lectures, with their own links), follow
// on lines of their own.

export interface Props {
  talk: Talk;
  /** An id, so that an address can point to the entry. */
  id?: string;
}

const { talk, id } = Astro.props;
const where = (event: string, place?: string) => [event, place].filter(Boolean).join(', ');
---

<li id={id} class="scroll-mt-24 py-3">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
    <h3 class="font-medium leading-snug text-heading">
      {talk.title ?? talk.event}
      {talk.note && <span class="text-sm font-normal text-muted">{` (${talk.note})`}</span>}
    </h3>
    <EntryLinks links={talkLinks(talk, talk.kind)} />
  </div>
  <p class="mt-0.5 text-sm text-muted">
    {talk.title ? where(talk.event, talk.place) : talk.place} · {talkDate(talk.date)} ·{' '}
    <span class:list={[talk.kind === 'invited' && 'font-semibold text-heading']}>{talkType(talk)}</span>
  </p>
  {
    talk.occasions?.map((occasion) => (
      <p class="text-sm text-muted">
        Also at {where(occasion.event, occasion.place)} · {talkDate(occasion.date)}
      </p>
    ))
  }
  {
    talk.parts && (
      <ul class="mt-1.5 space-y-1 border-l-2 border-gray-200 pl-3 dark:border-slate-700">
        {talk.parts.map((part) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-6 text-sm">
            <span class="text-default">{part.title}</span>
            <EntryLinks links={talkLinks(part)} />
          </li>
        ))}
      </ul>
    )
  }
</li>
