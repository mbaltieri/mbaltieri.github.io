---
import YearGroup from '~/components/research/YearGroup.astro';
import TalkEntry from '~/components/talks/TalkEntry.astro';
import { talksByDate, talksByYear } from '~/utils/talks';

// Every talk of src/data/talks.yaml, grouped by year. The first podcast is #podcasts, where the old
// podcast news addresses lead.

const firstPodcast = talksByDate().find((talk) => talk.kind === 'podcast');
---

{
  talksByYear().map(({ year, items }) => (
    <YearGroup year={year}>
      {items.map((talk) => (
        <TalkEntry talk={talk} id={talk === firstPodcast ? 'podcasts' : undefined} />
      ))}
    </YearGroup>
  ))
}
