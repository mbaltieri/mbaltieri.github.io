---
import YearGroup from '~/components/research/YearGroup.astro';
import PublicationEntry from '~/components/publications/PublicationEntry.astro';
import { publications, publicationsByYear } from '~/utils/publications';

// Every entry of src/data/publications.yaml, grouped by year. The first edited issue is #editing,
// where the old /research/editing/ address leads.

const firstEditing = publications.find((pub) => pub.kind === 'editing');
---

{
  publicationsByYear().map(({ year, items }) => (
    <YearGroup year={year}>
      {items.map((pub) => (
        <PublicationEntry pub={pub} id={pub === firstEditing ? 'editing' : undefined} />
      ))}
    </YearGroup>
  ))
}
