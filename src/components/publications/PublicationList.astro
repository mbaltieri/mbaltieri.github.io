---
import DatedList from '~/components/research/DatedList.astro';
import YearGroup from '~/components/research/YearGroup.astro';
import PublicationEntry from '~/components/publications/PublicationEntry.astro';
import { publications, publicationFilters, publicationsByYear } from '~/utils/publications';

// Every entry of src/data/publications.yaml, grouped by year, with a filter for each kind that has
// entries.

const filters = publicationFilters.filter(
  ({ id }) =>
    id === 'all' ||
    (id === 'selected' ? publications.some((pub) => pub.selected) : publications.some((pub) => pub.kind === id))
);
---

<DatedList label="Show publications by kind" filters={filters}>
  {
    publicationsByYear().map(({ year, items }) => (
      <YearGroup year={year}>
        {items.map((pub) => (
          <PublicationEntry pub={pub} />
        ))}
      </YearGroup>
    ))
  }
</DatedList>
