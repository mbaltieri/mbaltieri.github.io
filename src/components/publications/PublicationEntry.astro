---
import EntryLinks from '~/components/research/EntryLinks.astro';
import type { Publication } from '~/utils/publications';
import { publicationLinks, publicationType } from '~/utils/publications';

// A publication on two lines: its title, then the authors with Manuel in bold, where it appeared
// and what it is (in bold when it was invited, as for talks). Its links keep a column of their own
// on wide screens, on the right and level with the title, and follow the entry on phones, so that
// they are always in the same place. The same entry is used on the Publications page and the
// resume.

export interface Props {
  pub: Publication;
  /** An id, so that an address can point to the entry. */
  id?: string;
}

const { pub, id } = Astro.props;
const me = 'Baltieri, M.';
const authorParts = pub.authors.split(me);
const links = publicationLinks(pub);
---

<li
  id={id}
  class:list={[
    'grid scroll-mt-24 gap-x-6 gap-y-0.5 py-3 md:items-baseline',
    links.length > 0 && 'md:grid-cols-[minmax(0,1fr)_auto]',
  ]}
>
  <h3 class="font-medium leading-snug text-heading">{pub.title}</h3>
  <p class="text-sm text-muted md:col-span-full">
    {
      authorParts.map((part, index) => (
        <>
          {index > 0 && <strong class="font-semibold text-default">{me}</strong>}
          {part}
        </>
      ))
    }
    {
      pub.venue && (
        <>
          {' · '}
          <em>{pub.venue}</em>
        </>
      )
    }
    {' · '}
    <span class:list={[pub.invited && 'font-semibold text-heading']}>{publicationType(pub)}</span>
    {pub.note && `, ${pub.note}`}
  </p>
  <EntryLinks links={links} class="mt-0.5 md:col-start-2 md:row-start-1 md:mt-0" />
</li>
