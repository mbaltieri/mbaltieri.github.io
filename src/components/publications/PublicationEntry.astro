---
import EntryLinks from '~/components/research/EntryLinks.astro';
import type { Publication } from '~/utils/publications';
import { publicationLinks, publicationType } from '~/utils/publications';

// A publication on two lines: its title with its links, then the authors with Manuel in bold,
// where it appeared and what it is. The same entry is used on the Publications page and the
// resume.

export interface Props {
  pub: Publication;
  /** An id, so that an address can point to the entry. */
  id?: string;
}

const { pub, id } = Astro.props;
const me = 'Baltieri, M.';
const authorParts = pub.authors.split(me);
---

<li id={id} class="scroll-mt-24 py-3">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
    <h3 class="font-medium leading-snug text-heading">{pub.title}</h3>
    <EntryLinks links={publicationLinks(pub)} />
  </div>
  <p class="mt-0.5 text-sm text-muted">
    {
      authorParts.map((part, index) => (
        <>
          {index > 0 && <strong class="font-semibold text-default">{me}</strong>}
          {part}
        </>
      ))
    }
    {
      pub.venue && (
        <>
          {' · '}
          <em>{pub.venue}</em>
        </>
      )
    }
    {' · '}
    {publicationType(pub)}
    {pub.note && `, ${pub.note}`}
  </p>
</li>
