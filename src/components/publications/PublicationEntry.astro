---
import EntryLinks from '~/components/research/EntryLinks.astro';
import type { Publication } from '~/utils/publications';
import { publicationLinks } from '~/utils/publications';

// A publication on two lines: its title, then the authors with Manuel in bold and where it
// appeared, with "Invited submission" in bold for an invited paper, as "Invited talk" is for talks.
// The kind of paper (journal article, preprint and so on) is not shown. Its links keep a column of
// their own on wide screens, on the right and level with the title, and follow the entry on phones,
// so that they are always in the same place. Every entry keeps room in that column for links as
// wide as "Publisher · PDF · Preprint" (10rem), whether or not it has any, so that the lines of all
// entries end at the same place and none runs under the links. The same entry is used on the
// Publications page and the resume.

export interface Props {
  pub: Publication;
  /** An id, so that an address can point to the entry. */
  id?: string;
}

const { pub, id } = Astro.props;
const me = 'Baltieri, M.';
const authorParts = pub.authors.split(me);
const links = publicationLinks(pub);
---

<li
  id={id}
  class="grid scroll-mt-24 gap-x-6 gap-y-0.5 py-3 md:grid-cols-[minmax(0,1fr)_minmax(10rem,auto)] md:items-baseline"
>
  <h3 class="font-medium leading-snug text-heading">{pub.title}</h3>
  <p class="text-sm text-muted md:col-start-1">
    {
      authorParts.map((part, index) => (
        <>
          {index > 0 && <strong class="font-semibold text-default">{me}</strong>}
          {part}
        </>
      ))
    }
    {
      pub.venue && (
        <>
          {' · '}
          <em>{pub.venue}</em>
        </>
      )
    }
    {
      pub.invited && (
        <>
          {' · '}
          <span class="whitespace-nowrap font-semibold text-heading">Invited submission</span>
        </>
      )
    }
    {pub.note && `, ${pub.note}`}
  </p>
  <EntryLinks links={links} class="mt-0.5 md:col-start-2 md:row-start-1 md:mt-0" />
</li>
