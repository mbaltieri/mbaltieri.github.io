---
import LinkPills from '~/components/research/LinkPills.astro';
import type { Publication } from '~/utils/publications';
import { publicationLinks, publicationType } from '~/utils/publications';

// A publication: its title (marked if selected), the authors with Manuel in bold, where it appeared
// and what it is, and its links. The same entry is used on the Publications page and the resume.

export interface Props {
  pub: Publication;
  /** Leave out the "Selected" mark (on the resume, where every paper is a selected one). */
  noMark?: boolean;
}

const { pub, noMark = false } = Astro.props;
const me = 'Baltieri, M.';
const authorParts = pub.authors.split(me);
---

<li class="py-5" data-kinds={[pub.kind, pub.selected ? 'selected' : ''].filter(Boolean).join(' ')}>
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h3 class="text-lg font-semibold leading-snug text-heading">{pub.title}</h3>
    {
      pub.selected && !noMark && (
        <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary dark:bg-primary/25">
          Selected
        </span>
      )
    }
  </div>
  <p class="mt-1 text-muted">
    {
      authorParts.map((part, index) => (
        <>
          {index > 0 && <strong class="font-semibold text-default">{me}</strong>}
          {part}
        </>
      ))
    }
  </p>
  <p class="text-sm text-muted">
    {
      pub.venue && (
        <>
          <em>{pub.venue}</em> ·{' '}
        </>
      )
    }
    {publicationType(pub)}
    {pub.note && `, ${pub.note}`}
  </p>
  <LinkPills links={publicationLinks(pub)} class="mt-3" />
</li>
