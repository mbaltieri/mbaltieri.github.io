---
import type { Publication } from '~/utils/publications';
import { publicationLinks, publicationType } from '~/utils/publications';

export interface Props {
  pub: Publication;
  /** Leave out the "Selected" mark (on project pages, where it means nothing). */
  noMark?: boolean;
}

const { pub, noMark = false } = Astro.props;

const me = 'Baltieri, M.';
const authorParts = pub.authors.split(me);
const links = publicationLinks(pub);
---

<li class="py-5" data-kinds={[pub.kind, pub.selected ? 'selected' : ''].filter(Boolean).join(' ')}>
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h3 class="text-lg font-semibold leading-snug text-heading">{pub.title}</h3>
    {
      pub.selected && !noMark && (
        <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary dark:bg-primary/25 dark:text-blue-200">
          Selected
        </span>
      )
    }
  </div>
  <p class="mt-1 text-muted">
    {
      authorParts.map((part, index) => (
        <>
          {index > 0 && <strong class="font-semibold text-default">{me}</strong>}
          {part}
        </>
      ))
    }
  </p>
  <p class="text-sm text-muted">
    {
      pub.venue && (
        <>
          <em>{pub.venue}</em> ·{' '}
        </>
      )
    }
    {publicationType(pub)}
    {pub.note && `, ${pub.note}`}
  </p>
  {
    links.length > 0 && (
      <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium">
        {links.map(({ text, href }) => (
          <a class="text-primary hover:underline dark:text-blue-400" href={href}>
            {text}
          </a>
        ))}
      </p>
    )
  }
</li>
