---
import PublicationEntry from '~/components/publications/PublicationEntry.astro';
import { findPublication } from '~/utils/publications';

// A short list of publications picked by title, for a project page.

export interface Props {
  /** Titles exactly as in src/data/publications.yaml, in the order to print. */
  titles: Array<string>;
}

const { titles } = Astro.props;

const missing = titles.filter((title) => !findPublication(title));
if (missing.length) {
  throw new Error(`Not in src/data/publications.yaml: ${missing.map((title) => `"${title}"`).join(', ')}`);
}
---

<ul class="divide-y divide-gray-200 dark:divide-slate-800">
  {titles.map((title) => <PublicationEntry pub={findPublication(title)!} noMark />)}
</ul>
