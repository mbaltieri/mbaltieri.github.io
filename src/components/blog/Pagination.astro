---
import Button from '~/components/ui/Button.astro';
import { withTrailingSlash } from '~/utils/permalinks';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

// `prevUrl`/`nextUrl` come from Astro's `page.url` and already include `base`,
// so they must not go through `getPermalink()` (that would prefix `base` a
// second time, see #629). Astro's `trailingSlash` is 'ignore' on this site, so
// the slash the other links have is added here.
const { prevText = 'Newer posts', nextText = 'Older posts' } = Astro.props;
const prevUrl = withTrailingSlash(Astro.props.prevUrl);
const nextUrl = withTrailingSlash(Astro.props.nextUrl);
---

{
  (prevUrl || nextUrl) && (
    <div class="container flex">
      <div class="flex flex-row mx-auto container justify-between">
        <Button variant="tertiary" class={`md:px-3 px-3 mr-2 ${!prevUrl ? 'invisible' : ''}`} href={prevUrl}>
          <p>{prevText}</p>
        </Button>

        <Button variant="tertiary" class={`md:px-3 px-3 ${!nextUrl ? 'invisible' : ''}`} href={nextUrl}>
          <span>{nextText}</span>
        </Button>
      </div>
    </div>
  )
}
