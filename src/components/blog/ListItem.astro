---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

// One row of the News list: a small cover image beside the date, the kind, the title and the excerpt.

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) as ImageMetadata | undefined;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';

const imageFrame = 'relative block aspect-[16/10] overflow-hidden rounded-lg bg-gray-300 dark:bg-slate-700';
const imageProps = {
  class: 'absolute inset-0 h-full w-full object-cover',
  layout: 'cover' as const,
  widths: [400, 640],
  width: 640,
  height: 400,
  sizes: '(max-width: 767px) 100vw, 260px',
  alt: post.imageAlt || '',
  format: 'webp' as const,
  loading: 'lazy' as const,
  decoding: 'async' as const,
};
---

<article
  class:list={[
    'grid gap-5 md:gap-8 border-b border-gray-200 pb-8 dark:border-slate-800 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
    image ? 'md:grid-cols-[16.25rem_1fr]' : '',
  ]}
>
  {
    image &&
      (link ? (
        <a class={imageFrame} href={link} tabindex="-1" aria-hidden="true">
          <Image src={image} {...imageProps} />
        </a>
      ) : (
        <div class={imageFrame}>
          <Image src={image} {...imageProps} />
        </div>
      ))
  }
  <div>
    <p class="text-sm text-muted">
      <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
      {
        post.category && (
          <>
            {' · '}
            <a class="text-primary hover:underline" href={getPermalink(post.category.slug, 'category')}>
              {post.category.title}
            </a>
          </>
        )
      }
    </p>
    <h2 class="mt-1.5 font-heading text-xl sm:text-2xl font-medium leading-snug text-heading">
      {
        link ? (
          <a class="hover:text-primary transition" href={link}>
            {post.title}
          </a>
        ) : (
          post.title
        )
      }
    </h2>
    {post.excerptHtml && <p class="mt-2 text-muted [&_a]:underline" set:html={post.excerptHtml} />}
  </div>
</article>
