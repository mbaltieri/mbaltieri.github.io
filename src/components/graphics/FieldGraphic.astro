---
// Line drawings for the four research fields, in the style of the home page: primary-coloured
// line work, muted context and the accent for what matters. They are inline SVG, so they
// follow the light and dark themes.
//
//   control                          a string diagram: f and g in parallel, then h
//   cognition                        a bacterium running and tumbling up a sugar gradient
//   artificial-life                  a cyborg beetle, seen from above. Its upper side is machine: an
//                                    armour plate with rivets, gears, lights and circuits over the
//                                    wing case, vents on the thorax, a visor with two sensors, and
//                                    mechanical legs and antenna on jointed struts. Its lower side is its own:
//                                    legs, antenna and eye. A chip on its back is wired into all of
//                                    them, with electrodes in its own legs and antenna.
//   agent-foundations-for-ai-safety  a probability simplex, a prior moved to a posterior, and
//                                    Bayes' theorem

export interface Props {
  field: 'control' | 'cognition' | 'artificial-life' | 'agent-foundations-for-ai-safety';
  class?: string;
}

const { field, class: className = '' } = Astro.props;
const marker = `field-arrow-${field}`;

// Cognition: sugar rings, denser and larger towards the source on the right.
const hexagon = (cx: number, cy: number, r: number) =>
  Array.from({ length: 6 }, (_, i) => {
    const a = (Math.PI / 3) * i;
    return `${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`;
  }).join(' ');
const sugars = [
  [258, 92, 6.5],
  [243, 79, 4.5],
  [273, 105, 4.5],
  [249, 109, 4.5],
  [271, 77, 4.5],
  [287, 93, 4.5],
  [230, 95, 4],
  [226, 63, 3.5],
  [298, 62, 3.5],
  [294, 130, 3.5],
  [233, 130, 3.5],
  [205, 80, 3],
  [200, 118, 2.8],
];

// AI safety: the simplex of three hypotheses, and its barycentric grid at thirds.
const [A, B, C] = [
  [40, 168],
  [150, 168],
  [95, 72.7],
];
const mix = (p: Array<number>, q: Array<number>, s: number) => [p[0] + s * (q[0] - p[0]), p[1] + s * (q[1] - p[1])];
const grid = [1 / 3, 2 / 3].flatMap((s) => [
  [mix(A, C, s), mix(B, C, s)],
  [mix(A, B, s), mix(C, B, s)],
  [mix(B, A, s), mix(C, A, s)],
]);
---

<svg
  class:list={['text-primary', className]}
  viewBox="0 0 320 200"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <defs>
    <marker id={marker} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L10 5 L0 10 z" class="fill-current" stroke="none"></path>
    </marker>
  </defs>
  {
    field === 'control' && (
      <>
        <rect x="58" y="32" width="86" height="136" rx="12" class="stroke-muted" stroke-dasharray="4 5" opacity="0.6" />
        <line x1="14" y1="66" x2="72" y2="66" />
        <line x1="14" y1="134" x2="72" y2="134" />
        <rect x="72" y="46" width="58" height="40" rx="7" />
        <rect x="72" y="114" width="58" height="40" rx="7" />
        <path d="M130 66 C 162 66, 160 88, 190 88" />
        <path d="M130 134 C 162 134, 160 112, 190 112" />
        <rect x="190" y="68" width="62" height="64" rx="7" />
        <line x1="252" y1="100" x2="298" y2="100" />
        <circle cx="303" cy="100" r="4.5" class="fill-accent" stroke="none" />
        <g
          class="fill-current"
          stroke="none"
          font-family="Georgia, serif"
          font-style="italic"
          font-size="19"
          text-anchor="middle"
        >
          <text x="101" y="72">
            f
          </text>
          <text x="101" y="140">
            g
          </text>
          <text x="221" y="106">
            h
          </text>
        </g>
      </>
    )
  }
  {
    field === 'cognition' && (
      <>
        {[26, 48, 72].map((r) => (
          <circle cx="258" cy="92" r={r} class="stroke-muted" stroke-width="1" stroke-dasharray="3 5" opacity="0.5" />
        ))}
        {sugars.map(([x, y, r]) => (
          <polygon points={hexagon(x, y, r)} class="stroke-accent" stroke-width="1.2" />
        ))}
        <path d="M14 178 L 36 162 L 42 174 L 64 150 L 70 158 L 90.4 131.8" stroke-width="1.2" opacity="0.5" />
        <circle cx="36" cy="162" r="2" class="fill-muted" stroke="none" />
        <circle cx="64" cy="150" r="2" class="fill-muted" stroke="none" />
        <g transform="translate(156 116) rotate(-13.5) scale(1.35)" stroke-width="1.1">
          <path d="M-20 -3 q -5 -6 -10 0 t -10 0 t -10 0" stroke-width="1" />
          <path d="M-20 3 q -5 6 -10 0 t -10 0 t -10 0" stroke-width="1" />
          <rect x="-20" y="-8" width="40" height="16" rx="8" />
          <path d="M-8 -1 C -2 -4, 4 2, 10 -1" stroke-width="1" opacity="0.6" />
        </g>
      </>
    )
  }
  {
    field === 'artificial-life' && (
      <>
        <path
          d="M184.2 85.2 L 194.2 67.2 L 189.8 64.8 L 179.8 82.8 Z M164.4 77.3 L 158.4 55.3 L 153.6 56.7 L 159.6 78.7 Z M139.8 72.2 L 119.8 52.2 L 116.2 55.8 L 136.2 75.8 Z"
          class="fill-page"
          stroke-width="1.2"
        />
        <path d="M192 66 L 208 60 M156 56 L 168 42 M118 54 L 102 46" stroke-width="2.2" />
        <path
          d="M208 60 l 4 -4 M208 60 l 5 1 M168 42 l 2 -5 M168 42 l 5 -1 M102 46 l -2 -5 M102 46 l -5 1"
          stroke-width="1.2"
        />
        <path d="M210 94 L 222 84 L 233 77 L 243 71.5" stroke-width="2" />
        <g stroke-width="1.1">
          <path d="M182 116 L 192 134 L 208 140 M162 122 L 156 144 L 168 158 M138 126 L 118 146 L 102 154" />
          <path d="M210 106 C 222 114, 230 126, 244 132" />
        </g>
        <path d="M78 100 A 48 31 0 0 0 174 100 Z" class="fill-current" fill-opacity="0.08" stroke="none" />
        <path d="M78 100 A 48 31 0 0 0 174 100" />
        <path
          d="M78 100 L 88 80 L 108 70 L 146 70 L 166 80 L 174 100 Z"
          class="fill-current"
          fill-opacity="0.16"
          stroke="none"
        />
        <path d="M78 100 L 88 80 L 108 70 L 146 70 L 166 80 L 174 100" />
        <path d="M78 100 H 174 M108 72 V 99" stroke-width="1" opacity="0.7" />
        <g class="fill-current" stroke="none">
          <circle cx="88" cy="94" r="1.3" />
          <circle cx="92" cy="83" r="1.3" />
          <circle cx="160" cy="82" r="1.3" />
          <circle cx="94" cy="92" r="1.2" />
          <circle cx="102.6" cy="81.6" r="0.9" />
          <rect x="116" y="73.6" width="2.6" height="2.6" rx="0.4" />
          <rect x="121.5" y="73.6" width="2.6" height="2.6" rx="0.4" />
          <rect x="127" y="73.6" width="2.6" height="2.6" rx="0.4" />
        </g>
        <circle cx="94" cy="92" r="4.6" stroke-width="1.1" />
        <path
          d="M94 85 V 87.4 M94 96.6 V 99 M87 92 H 89.4 M98.6 92 H 101 M89 87 l 1.7 1.7 M97.3 95.3 l 1.7 1.7 M89 97 l 1.7 -1.7 M97.3 88.7 l 1.7 -1.7"
          stroke-width="1.5"
        />
        <circle cx="102.6" cy="81.6" r="2.9" stroke-width="1" />
        <path
          d="M102.6 77.2 V 78.7 M102.6 84.5 V 86 M98.2 81.6 H 99.7 M105.5 81.6 H 107 M99.5 78.5 l 1 1 M104.7 83.7 l 1 1 M99.5 84.7 l 1 -1 M104.7 79.5 l 1 -1"
          stroke-width="1.2"
        />
        <g stroke-width="1">
          <path d="M152 93 H 140 L 134 87 H 118 M152 97 H 128 L 123 92.5 H 116 M146 93 V 79" />
          <circle cx="115.5" cy="87" r="2.3" />
          <circle cx="146" cy="76.6" r="2.3" />
        </g>
        <path
          d="M169 100 A 15 20 0 0 0 199 100 Z M169 100 L 172 86 L 180 80 L 190 80 L 197 87 L 199 100 Z"
          class="fill-page"
        />
        <path d="M182 86 H 193 M182 89.5 H 194 M182 93 H 195" stroke-width="1" opacity="0.7" />
        <path d="M197 100 A 8 10 0 0 0 213 100 Z M197 100 L 199 91 L 205 88.5 L 211 91 L 213 100 Z" class="fill-page" />
        <circle cx="208.5" cy="105" r="1.4" class="fill-current" stroke="none" />
        <path
          d="M157 115 C 150 119, 144 123, 138 126 M165 115 C 164 118, 163 120, 162 122 M173 115 L 182 116 M173 85 L 182 84 M165 85 C 164 82, 163 80, 162 78 M157 85 C 150 82, 144 78, 138 74"
          stroke-width="0.9"
        />
        <g class="fill-current" stroke="none">
          <circle cx="138" cy="126" r="2" />
          <circle cx="162" cy="122" r="2" />
          <circle cx="182" cy="116" r="2" />
        </g>
        <path d="M176 95 C 190 92, 198 92, 205 94 M176 105 C 190 108, 198 108, 210 106" stroke-width="1" />
        <rect x="152" y="89" width="26" height="22" rx="2" class="fill-page" stroke-width="1.3" />
        <path
          d="M157 85 V 89 M165 85 V 89 M173 85 V 89 M157 111 V 115 M165 111 V 115 M173 111 V 115"
          stroke-width="1"
        />
        <circle cx="165" cy="100" r="2.6" class="fill-accent" stroke="none" />
        <circle cx="210" cy="106" r="2.4" class="fill-accent" stroke="none" />
        <circle cx="206" cy="94.5" r="4.6" class="fill-page" stroke-width="1.2" />
        <circle cx="206" cy="94.5" r="2.6" stroke-width="0.8" opacity="0.7" />
        <circle cx="206.4" cy="94.2" r="1.5" class="fill-accent" stroke="none" />
        <circle cx="200.2" cy="93.4" r="1.3" class="fill-current" stroke="none" />
        <g class="fill-page" stroke-width="1.2">
          <circle cx="182" cy="84" r="3.2" />
          <circle cx="162" cy="78" r="3.2" />
          <circle cx="138" cy="74" r="3.2" />
          <circle cx="192" cy="66" r="3.2" />
          <circle cx="156" cy="56" r="3.2" />
          <circle cx="118" cy="54" r="3.2" />
          <circle cx="222" cy="84" r="2.4" />
          <circle cx="233" cy="77" r="2.4" />
        </g>
        <g class="fill-current" stroke="none">
          <circle cx="182" cy="84" r="1" />
          <circle cx="162" cy="78" r="1" />
          <circle cx="138" cy="74" r="1" />
          <circle cx="192" cy="66" r="1" />
          <circle cx="156" cy="56" r="1" />
          <circle cx="118" cy="54" r="1" />
        </g>
        <circle cx="246" cy="70" r="3.2" class="fill-accent" stroke="none" />
      </>
    )
  }
  {
    field === 'agent-foundations-for-ai-safety' && (
      <>
        {grid.map(([p, q]) => (
          <line x1={p[0]} y1={p[1]} x2={q[0]} y2={q[1]} class="stroke-muted" stroke-width="1" opacity="0.4" />
        ))}
        <polygon points={[A, B, C].map((p) => p.join(',')).join(' ')} />
        {[A, B, C].map(([x, y]) => (
          <circle cx={x} cy={y} r="3" fill="currentColor" stroke="none" />
        ))}
        <circle cx="95" cy="136.2" r="4" class="fill-muted" stroke="none" />
        <path d="M95.6 130 L 99.2 106" marker-end={`url(#${marker})`} />
        <circle cx="100" cy="98" r="5" class="fill-accent" stroke="none" />
        <g stroke="none" font-family="Georgia, serif" font-style="italic" font-size="15">
          <text x="164" y="124" class="fill-accent">
            p(h|d)
          </text>
          <text x="214" y="124" class="fill-current">
            =
          </text>
          <g class="fill-current" text-anchor="middle">
            <text x="270" y="111">
              p(d|h) p(h)
            </text>
            <text x="270" y="139">
              p(d)
            </text>
          </g>
        </g>
        <line x1="230" y1="119" x2="310" y2="119" stroke-width="1.2" />
      </>
    )
  }
</svg>

<style>
  /* Shapes that hide what lies under them (the beetle's chip, head, thorax, struts and joints) take
     the page's colour. */
  .fill-page {
    fill: var(--aw-color-bg-page);
  }
</style>
