---
// The light of the home page, for use inside an <svg>: a bright core with two faint halos.

export interface Props {
  x: number;
  y: number;
  /** Radius of the core. */
  r?: number;
}

const { x, y, r = 4.5 } = Astro.props;
---

<g class="fill-accent" stroke="none">
  <circle cx={x} cy={y} r={r * 5.5} opacity="0.12"></circle>
  <circle cx={x} cy={y} r={r * 3} opacity="0.25"></circle>
  <circle cx={x} cy={y} r={r}></circle>
</g>
