---
// The links of an entry (a paper, a talk, a lecture), as small pills under fixed names. The
// resume hides them on paper (data-links).

export interface Props {
  links: Array<{ text: string; href: string }>;
  class?: string;
}

const { links, class: className = '' } = Astro.props;
---

{
  links.length > 0 && (
    <p data-links class:list={['flex flex-wrap gap-2', className]}>
      {links.map(({ text, href }) => (
        <a
          class="rounded-full border border-primary/35 px-2.5 py-0.5 text-xs font-medium text-primary transition hover:border-primary hover:bg-primary/10"
          href={href}
        >
          {text}
        </a>
      ))}
    </p>
  )
}
