---
// The top of the Publications and Talks pages, kept small: the title and a line about the list.

export interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<header class="mx-auto max-w-4xl px-4 pt-12 pb-8 text-center md:px-6 md:pt-16">
  <h1 class="font-heading text-4xl font-bold tracking-tight text-heading md:text-5xl">{title}</h1>
  <p class="mx-auto mt-3 max-w-2xl text-lg text-muted">{subtitle}</p>
</header>
