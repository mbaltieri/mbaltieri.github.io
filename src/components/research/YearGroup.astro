---
// A year of a list of papers or talks: the year on the left on wide screens, above its entries on
// phones.

export interface Props {
  year: number;
}

const { year } = Astro.props;
---

<div class="grid gap-x-6 border-t border-gray-200 md:grid-cols-[4rem_1fr] dark:border-slate-800">
  <p class="pt-3 font-heading text-lg font-semibold tabular-nums text-heading md:sticky md:top-20 md:self-start">
    {year}
  </p>
  <ul class="divide-y divide-gray-100 dark:divide-slate-800/60">
    <slot />
  </ul>
</div>
