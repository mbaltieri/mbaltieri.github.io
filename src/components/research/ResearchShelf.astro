---
import { Icon } from 'astro-icon/components';
import { publications } from '~/utils/publications';
import { getPermalink } from '~/utils/permalinks';
import { talksByDate, talkDate } from '~/utils/talks';

// The way from the Research page to the Publications and Talks pages: a card for each, with its
// three latest entries. The whole card is a link.

const cards = [
  {
    title: 'Publications',
    icon: 'tabler:file-text',
    href: getPermalink('/research/publications'),
    more: 'All publications',
    items: publications
      .slice(0, 3)
      .map((pub) => ({ title: pub.title, meta: [pub.venue, pub.year].filter(Boolean).join(', ') })),
  },
  {
    title: 'Talks',
    icon: 'tabler:presentation',
    href: getPermalink('/research/talks'),
    more: 'All talks',
    items: talksByDate()
      .slice(0, 3)
      .map((talk) => ({
        title: talk.title ?? talk.event,
        meta: [talk.title ? talk.event : talk.place, talkDate(talk.date)].filter(Boolean).join(', '),
      })),
  },
];
---

<section class="mx-auto max-w-5xl px-4 pb-4 md:px-6 print:hidden">
  <div class="grid gap-6 md:grid-cols-2">
    {
      cards.map(({ title, icon, href, more, items }) => (
        <article class="group relative flex flex-col rounded-xl border border-gray-200 p-6 transition hover:border-primary/60 dark:border-slate-800 md:p-7">
          <div class="flex items-center gap-3">
            <Icon name={icon} class="h-7 w-7 text-primary" />
            <h2 class="font-heading text-2xl font-semibold text-heading">
              <a href={href} class="after:absolute after:inset-0 after:rounded-xl focus:outline-none">
                {title}
              </a>
            </h2>
          </div>
          <h3 class="mt-5 text-xs font-semibold uppercase tracking-wide text-muted">Latest</h3>
          <ul class="mt-1 divide-y divide-gray-200 dark:divide-slate-800">
            {items.map((item) => (
              <li class="py-2.5">
                <span class="block font-medium leading-snug text-heading">{item.title}</span>
                <span class="text-sm text-muted">{item.meta}</span>
              </li>
            ))}
          </ul>
          <span class="mt-auto pt-5 font-medium text-primary group-hover:underline">{more}</span>
        </article>
      ))
    }
  </div>
</section>
