---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Widget } from '~/types';

// The research diagram: agent and environment at the centre, a box for each field below.
// Selecting a box shows that field's card (one at a time, with a fade), selecting it again
// closes it, and nothing is open at first. The open field is kept in the address
// (#artificial-life, ...), so it can be linked to. Without scripts every card is shown and
// the boxes are links to them.

export interface ResearchField {
  id: string;
  number: string;
  name: string;
  keywords: string;
  title: string;
  text: string;
  papers: Array<{ title: string; href: string }>;
}

export interface Props extends Widget {
  label?: string;
  fields: Array<ResearchField>;
}

const { label, fields, id, isDark = false, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <research-map class="block" aria-label={label}>
    <div
      class="mx-auto max-w-xl rounded-xl border border-gray-200 bg-white p-6 text-center shadow-sm dark:border-slate-700 dark:bg-slate-900"
    >
      <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-primary">Formal focus</p>
      <p
        class="mt-2 font-heading text-2xl font-bold text-heading md:text-3xl"
        role="img"
        aria-label="Agent interacting bidirectionally with environment"
      >
        Agent <span class="mx-2 text-primary" aria-hidden="true">&#8644;</span> Environment
      </p>
      <p class="mt-2 text-muted">models · goals · interfaces · interactions</p>
    </div>

    <div role="group" aria-label="Research fields" class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        fields.map((field) => (
          <a
            href={`#${field.id}`}
            data-field={field.id}
            class="flex flex-col rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md aria-expanded:border-primary aria-expanded:ring-2 aria-expanded:ring-primary/30 dark:border-slate-700 dark:bg-slate-900"
          >
            <span class="text-sm font-bold text-primary dark:text-primary" aria-hidden="true">
              {field.number}
            </span>
            <strong class="mt-1 text-lg text-heading">{field.name}</strong>
            <span class="mt-1 text-sm text-muted">{field.keywords}</span>
          </a>
        ))
      }
    </div>

    <p class="mt-6 text-center text-muted" data-hint hidden>Select a field to read about it.</p>

    <div class="mt-6 space-y-6">
      {
        fields.map((field) => (
          <section
            id={field.id}
            data-card
            aria-labelledby={`${field.id}-title`}
            class="scroll-mt-24 rounded-xl border border-gray-200 bg-white p-6 shadow-sm motion-safe:animate-fade dark:border-slate-700 dark:bg-slate-900 md:p-8"
          >
            <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-primary">
              {field.number} · {field.name}
            </p>
            <h2 id={`${field.id}-title`} class="mt-1 font-heading text-2xl font-bold text-heading">
              {field.title}
            </h2>
            <p class="mt-3 text-muted">{field.text}</p>
            <ul class="mt-4 list-disc space-y-1 pl-5">
              {field.papers.map((paper) => (
                <li>
                  <a class="text-primary hover:underline dark:text-primary" href={paper.href}>
                    {paper.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </research-map>
  <noscript
    ><style is:inline>
      research-map [data-card] {
        display: block !important;
      }
    </style></noscript
  >
</WidgetWrapper>

<style>
  /* No card shows before the script decides which one is open. Without scripts the rule in <noscript> wins. */
  research-map:not(:defined) [data-card] {
    display: none;
  }
</style>

<script>
  class ResearchMap extends HTMLElement {
    connectedCallback() {
      this.boxes().forEach((box) => {
        box.setAttribute('role', 'button');
        box.setAttribute('aria-controls', box.dataset.field ?? '');
      });
      this.addEventListener('click', this.onClick);
      this.addEventListener('keydown', this.onKeyDown);
      window.addEventListener('hashchange', this.onHashChange);
      const card = this.show(this.fieldInAddress());
      if (card) setTimeout(() => this.reveal(card), 0);
    }

    disconnectedCallback() {
      window.removeEventListener('hashchange', this.onHashChange);
    }

    boxes() {
      return [...this.querySelectorAll<HTMLElement>('[data-field]')];
    }

    /** Shows the card of field `id`, or none for ''. Returns the card now open, if any. */
    show(id: string): HTMLElement | null {
      let open: HTMLElement | null = null;
      this.boxes().forEach((box) => {
        const on = box.dataset.field === id;
        box.setAttribute('aria-expanded', String(on));
        const card = box.dataset.field ? document.getElementById(box.dataset.field) : null;
        if (card) card.hidden = !on;
        if (on) open = card;
      });
      const hint = this.querySelector<HTMLElement>('[data-hint]');
      if (hint) hint.hidden = !!open;
      return open;
    }

    /** The field named in the address. An address inside a card (its heading, say) counts as that card. */
    fieldInAddress(): string {
      let id = location.hash.slice(1);
      try {
        id = decodeURIComponent(id);
      } catch {
        // Keep the address as it is.
      }
      const card = id ? document.getElementById(id)?.closest<HTMLElement>('[data-card]') : null;
      return card && this.contains(card) ? card.id : '';
    }

    /** Scrolls just enough for a card that opened outside the window to be seen. */
    reveal(card: HTMLElement) {
      const rect = card.getBoundingClientRect();
      const height = window.innerHeight;
      let by = 0;
      if (rect.height > height - 140 || rect.top < 96) by = rect.top - 110;
      else if (rect.bottom > height - 24) by = rect.bottom - height + 24;
      if (!by) return;
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollBy({ top: by, behavior: still ? 'auto' : 'smooth' });
    }

    onClick = (event: MouseEvent) => {
      const box = (event.target as HTMLElement).closest<HTMLElement>('[data-field]');
      // Ctrl-, cmd- and shift-clicks are left to the browser: the box is also a link to its card.
      if (!box || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const id = box.getAttribute('aria-expanded') === 'true' ? '' : (box.dataset.field ?? '');
      const card = this.show(id);
      history.replaceState(history.state, '', id ? `#${id}` : location.pathname + location.search);
      if (card) this.reveal(card);
    };

    /** The boxes act as buttons, so the space bar works on them as well as Enter. */
    onKeyDown = (event: KeyboardEvent) => {
      if (event.key !== ' ') return;
      const box = (event.target as HTMLElement).closest<HTMLElement>('[data-field]');
      if (!box) return;
      event.preventDefault();
      box.click();
    };

    onHashChange = () => {
      const card = this.show(this.fieldInAddress());
      if (card) this.reveal(card);
    };
  }

  if (!customElements.get('research-map')) customElements.define('research-map', ResearchMap);
</script>
