---
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import FieldGraphic from '~/components/graphics/FieldGraphic.astro';
import VisionGraphic from '~/components/graphics/VisionGraphic.astro';
import Reference from '~/components/research/Reference.astro';
import type { Props as FieldGraphicProps } from '~/components/graphics/FieldGraphic.astro';
import type { Props as VisionGraphicProps } from '~/components/graphics/VisionGraphic.astro';
import type { Widget } from '~/types';

// The areas of research as tabs: a row of drawings, one per area, and under the selected one its
// introduction and the questions it takes up. Pressing a question shows its answer, with its papers
// and links. Each answer opens and closes on its own, so that opening one never moves the question
// pressed. The first area is shown at first, or the one named in the address: an area
// (#artificial-life) or a question (#boundaries), which then opens. Areas fade in with the site's
// fade, after the one shown has faded out, and answers fade in as they slide open.
// The address follows the selected area. Without scripts every area is shown and the questions
// still open, and on paper every area and every answer is printed.

export interface ResearchPaper {
  title: string;
  href?: string;
  venue?: string;
  year: number;
}

export interface ResearchQuestion {
  id: string;
  /** A short name for the question, for links to it. */
  label: string;
  question: string;
  /** Paragraphs, as HTML. */
  answer: Array<string>;
  /** A remark set apart after the answer, as HTML. */
  aside?: string;
  papers?: Array<ResearchPaper>;
  links?: Array<{ text: string; href: string }>;
  /** A line over the links, saying what they are. */
  linksNote?: string;
  drawing?: VisionGraphicProps['name'];
}

export interface ResearchField {
  id: FieldGraphicProps['field'];
  name: string;
  keywords: string;
  title: string;
  text: string;
  questions: Array<ResearchQuestion>;
  /** Papers of the area that belong to none of its questions. */
  papers?: Array<ResearchPaper>;
}

export interface Props extends Widget {
  label?: string;
  fields: Array<ResearchField>;
}

const { label, fields, id, isDark = false, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;

const small = 'text-sm font-semibold uppercase tracking-wide text-muted';
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-5xl mx-auto print:pb-0 ${classes?.container ?? ''}`}
  bg={bg}
>
  <h2 class="mb-8 font-heading text-2xl font-semibold text-heading md:mb-10 md:text-3xl print:mb-4">
    Areas of research
  </h2>
  <research-fields class="block">
    <div
      data-tabs
      data-label={label}
      class="grid grid-cols-2 gap-x-5 gap-y-8 sm:gap-x-8 lg:grid-cols-4 print:grid-cols-4 print:gap-x-4"
    >
      {
        fields.map((field) => (
          <a
            href={`#${field.id}`}
            data-field={field.id}
            class="group block border-t border-gray-200 pt-5 outline-offset-4 transition-shadow aria-selected:shadow-[inset_0_2px_0_var(--aw-color-primary)] print:shadow-none dark:border-slate-800"
          >
            <FieldGraphic
              field={field.id}
              class="h-auto w-full opacity-55 transition-opacity group-hover:opacity-100 group-aria-selected:opacity-100 print:opacity-100"
            />
            <span class="mt-4 block font-heading text-lg md:text-xl font-medium text-heading transition group-aria-selected:text-primary">
              {field.name}
            </span>
            <span class="mt-1 block text-sm text-muted">{field.keywords}</span>
          </a>
        ))
      }
    </div>

    <div class="mt-12 space-y-16 md:mt-16 print:mt-8 print:space-y-8">
      {
        fields.map((field) => (
          <section
            id={field.id}
            data-card
            aria-labelledby={`${field.id}-title`}
            class="grid scroll-mt-24 gap-6 motion-safe:animate-fade md:grid-cols-12 md:gap-12"
          >
            <div class="md:sticky md:top-24 md:col-span-5 md:self-start">
              <p class="text-sm font-semibold uppercase tracking-wide text-primary">{field.name}</p>
              <h3
                id={`${field.id}-title`}
                class="mt-2 font-heading text-3xl md:text-4xl font-semibold leading-tight tracking-tight text-heading"
              >
                {field.title}
              </h3>
              <p class="mt-5 text-lg text-muted">{field.text}</p>
            </div>
            <div class="md:col-span-7">
              <h4 class={small}>Questions</h4>
              <div class="mt-3 divide-y divide-gray-200 border-y border-gray-200 dark:divide-slate-800 dark:border-slate-800">
                {field.questions.map((item) => (
                  <details id={item.id} class="group scroll-mt-28">
                    <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 [&::-webkit-details-marker]:hidden">
                      <span class="font-heading text-xl font-medium leading-snug text-heading transition group-hover:text-primary">
                        {item.question}
                      </span>
                      <Icon
                        name="tabler:plus"
                        class="mt-1 h-5 w-5 shrink-0 text-primary transition-transform duration-200 group-open:rotate-45 print:hidden"
                      />
                    </summary>
                    <div data-answer>
                      <div class="pb-6">
                        <div class="flow-root border-l-2 border-primary/30 pl-5 text-default [&_p_a]:text-primary [&_p_a:hover]:underline">
                          {item.drawing && (
                            <figure class="mb-4 max-w-xs md:float-right md:mb-2 md:ml-6 md:w-52">
                              <VisionGraphic name={item.drawing} class="h-auto w-full" />
                            </figure>
                          )}
                          {item.answer.map((paragraph) => (
                            <p class="mb-3" set:html={paragraph} />
                          ))}
                          {item.aside && (
                            <p
                              class="mb-3 border-l-2 border-accent pl-3 text-sm italic text-muted"
                              set:html={item.aside}
                            />
                          )}
                          {item.papers?.length ? (
                            <>
                              <h5 class:list={[small, 'mt-5 text-xs']}>Papers</h5>
                              <ul class="mt-2.5 space-y-2.5">
                                {item.papers.map((paper) => (
                                  <Reference
                                    icon="tabler:file-text"
                                    title={paper.title}
                                    href={paper.href}
                                    detail={[paper.venue, paper.year].filter(Boolean).join(', ')}
                                  />
                                ))}
                              </ul>
                            </>
                          ) : null}
                          {item.links?.length ? (
                            <>
                              <h5 class:list={[small, 'mt-5 text-xs']}>Links</h5>
                              {item.linksNote && <p class="mt-1 text-sm text-muted">{item.linksNote}</p>}
                              <ul class="mt-2.5 space-y-2.5">
                                {item.links.map((link) => (
                                  <Reference icon="tabler:link" title={link.text} href={link.href} />
                                ))}
                              </ul>
                            </>
                          ) : null}
                        </div>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
              {field.papers?.length ? (
                <>
                  <h4 class:list={[small, 'mt-10']}>Other papers</h4>
                  <ul class="mt-3 space-y-2.5">
                    {field.papers.map((paper) => (
                      <Reference
                        icon="tabler:file-text"
                        title={paper.title}
                        href={paper.href}
                        detail={[paper.venue, paper.year].filter(Boolean).join(', ')}
                      />
                    ))}
                  </ul>
                </>
              ) : null}
            </div>
          </section>
        ))
      }
    </div>
  </research-fields>
  <noscript
    ><style is:inline>
      research-fields [data-card] {
        display: grid !important;
      }
    </style></noscript
  >
</WidgetWrapper>

<style>
  /* Only the selected area is shown (only the first one until the script has picked one).
     Without scripts the rule in <noscript> wins, and on paper every area is printed. */
  research-fields:not(:defined) [data-card]:not(:first-child),
  research-fields:defined [data-card]:not([data-open]) {
    display: none;
  }
  @media print {
    research-fields [data-card] {
      display: grid !important;
      animation: none !important;
      break-inside: auto;
    }
  }
</style>

<script>
  const still = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  class ResearchFields extends HTMLElement {
    private openBeforePrint: Array<HTMLDetailsElement> = [];
    private leaving: Animation | null = null;
    private chosen = '';

    connectedCallback() {
      const list = this.querySelector<HTMLElement>('[data-tabs]');
      list?.setAttribute('role', 'tablist');
      if (list?.dataset.label) list.setAttribute('aria-label', list.dataset.label);
      this.tabs().forEach((tab) => {
        const panel = this.panel(tab);
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', tab.dataset.field ?? '');
        panel?.setAttribute('role', 'tabpanel');
      });
      this.addEventListener('click', this.onClick);
      this.addEventListener('keydown', this.onKeyDown);
      window.addEventListener('hashchange', this.onHashChange);
      window.addEventListener('beforeprint', this.onBeforePrint);
      window.addEventListener('afterprint', this.onAfterPrint);
      const named = this.fieldInAddress();
      this.select(named || this.tabs()[0]?.dataset.field || '');
      if (named) setTimeout(() => this.reveal(this.openNamed()), 0);
    }

    disconnectedCallback() {
      window.removeEventListener('hashchange', this.onHashChange);
      window.removeEventListener('beforeprint', this.onBeforePrint);
      window.removeEventListener('afterprint', this.onAfterPrint);
    }

    tabs() {
      return [...this.querySelectorAll<HTMLElement>('[data-field]')];
    }

    panel(tab: HTMLElement) {
      return tab.dataset.field ? document.getElementById(tab.dataset.field) : null;
    }

    /** Marks the tab of the area `id` as the selected one. */
    mark(id: string) {
      this.tabs().forEach((tab) => {
        const on = tab.dataset.field === id;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
    }

    /** Shows the area `id` and hides the others (the one shown fades in, see the panels' classes). */
    show(id: string) {
      this.tabs().forEach((tab) => this.panel(tab)?.toggleAttribute('data-open', tab.dataset.field === id));
    }

    select(id: string) {
      this.mark(id);
      this.show(id);
    }

    /** The element named in the address, if it is in one of the areas. */
    named(): HTMLElement | null {
      let id = location.hash.slice(1);
      try {
        id = decodeURIComponent(id);
      } catch {
        // Keep the address as it is.
      }
      const element = id ? document.getElementById(id) : null;
      return element && this.contains(element) ? element : null;
    }

    /** The area named in the address, or holding what the address names (a question, say). */
    fieldInAddress(): string {
      return this.named()?.closest<HTMLElement>('[data-card]')?.id ?? '';
    }

    /** Opens the question named in the address, if it names one, and returns what to bring into view. */
    openNamed(): HTMLElement {
      const question = this.named()?.closest<HTMLDetailsElement>('details');
      if (question) question.open = true;
      return question ?? this;
    }

    /** Brings an element into view, unless it already is near the top of the window. */
    reveal(element: HTMLElement) {
      const top = element.getBoundingClientRect().top;
      if (top > 80 && top < window.innerHeight / 3) return;
      window.scrollBy({ top: top - 96, behavior: still() ? 'auto' : 'smooth' });
    }

    /** Selects an area: the one shown fades out first, unless visitors ask for less motion. */
    choose(tab: HTMLElement, focus = false) {
      const id = tab.dataset.field ?? '';
      history.replaceState(history.state, '', `#${id}`);
      if (focus) tab.focus();
      this.mark(id);
      this.chosen = id;
      // A fade-out under way ends by showing the area chosen last.
      if (this.leaving) return;
      const shown = this.querySelector<HTMLElement>('[data-card][data-open]');
      if (!shown || shown.id === id || still()) {
        this.show(id);
        return;
      }
      const leaving = shown.animate([{ opacity: 1 }, { opacity: 0 }], {
        duration: 160,
        easing: 'ease-in',
        fill: 'forwards',
      });
      this.leaving = leaving;
      leaving.onfinish = () => {
        this.show(this.chosen);
        leaving.cancel();
        this.leaving = null;
      };
    }

    /** Opens or closes an answer: it fades in as it slides open, and fades out as it slides shut. */
    toggle(question: HTMLDetailsElement) {
      const answer = question.querySelector<HTMLElement>('[data-answer]');
      answer?.getAnimations().forEach((animation) => animation.finish());
      if (!answer || still()) {
        question.open = !question.open;
        return;
      }
      const opening = !question.open;
      question.open = true;
      const height = `${answer.offsetHeight}px`;
      answer.style.overflow = 'hidden';
      const sliding = answer.animate(
        opening
          ? [
              { height: '0px', opacity: 0 },
              { height, opacity: 1 },
            ]
          : [
              { height, opacity: 1 },
              { height: '0px', opacity: 0 },
            ],
        { duration: opening ? 380 : 260, easing: opening ? 'ease-out' : 'ease-in', fill: 'forwards' }
      );
      sliding.onfinish = () => {
        if (!opening) question.open = false;
        answer.style.overflow = '';
        sliding.cancel();
      };
    }

    onClick = (event: MouseEvent) => {
      const summary = (event.target as HTMLElement).closest('summary');
      if (summary?.parentElement instanceof HTMLDetailsElement && this.contains(summary)) {
        event.preventDefault();
        this.toggle(summary.parentElement);
        return;
      }
      const tab = (event.target as HTMLElement).closest<HTMLElement>('[data-field]');
      // Ctrl-, cmd- and shift-clicks are left to the browser: the drawings are also links to their areas.
      if (!tab || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      this.choose(tab);
    };

    /** Arrow keys, Home and End move between the tabs, and the space bar selects like Enter. */
    onKeyDown = (event: KeyboardEvent) => {
      const tab = (event.target as HTMLElement).closest<HTMLElement>('[data-field]');
      if (!tab) return;
      const tabs = this.tabs();
      const at = tabs.indexOf(tab);
      const to = {
        ArrowRight: at + 1,
        ArrowDown: at + 1,
        ArrowLeft: at - 1,
        ArrowUp: at - 1,
        Home: 0,
        End: tabs.length - 1,
      }[event.key];
      if (to !== undefined) {
        event.preventDefault();
        this.choose(tabs[(to + tabs.length) % tabs.length], true);
      } else if (event.key === ' ') {
        event.preventDefault();
        this.choose(tab);
      }
    };

    onHashChange = () => {
      const id = this.fieldInAddress();
      if (!id) return;
      this.select(id);
      this.reveal(this.openNamed());
    };

    /** On paper every answer is printed: open them all, and close again afterwards those that were closed. */
    onBeforePrint = () => {
      const all = [...this.querySelectorAll<HTMLDetailsElement>('details')];
      this.openBeforePrint = all.filter((details) => details.open);
      all.forEach((details) => (details.open = true));
    };

    onAfterPrint = () => {
      this.querySelectorAll<HTMLDetailsElement>('details').forEach((details) => {
        details.open = this.openBeforePrint.includes(details);
      });
    };
  }

  if (!customElements.get('research-fields')) customElements.define('research-fields', ResearchFields);
</script>
