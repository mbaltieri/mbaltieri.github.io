---
// Agent and environment, wired both ways, and below them the fields that study them.
// The agent is drawn as one of the vehicles of the home page, the environment as its light.

export interface Props {
  fields: Array<{ label: string; href: string }>;
}

const { fields } = Astro.props;

const box =
  'flex shrink-0 items-center gap-3 rounded-xl border-[1.5px] border-primary bg-white/70 dark:bg-slate-900/60 px-4 py-3 sm:px-6 sm:py-4';
const label = 'font-heading text-lg sm:text-2xl font-semibold text-heading';
const rail = 'bg-gray-300 dark:bg-slate-600';
---

<figure class="not-prose mx-auto max-w-4xl">
  <div class="mx-auto flex max-w-2xl items-center">
    <div class={box}>
      <svg class="hidden sm:block h-8 w-11 text-primary" viewBox="0 0 44 32" aria-hidden="true">
        <rect x="6" y="6" width="28" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
        <rect x="8" y="2" width="11" height="4" rx="1" fill="currentColor"></rect>
        <rect x="8" y="26" width="11" height="4" rx="1" fill="currentColor"></rect>
        <path d="M32 11 L12 23 M32 21 L12 9" stroke="currentColor" stroke-width="1"></path>
        <circle class="fill-accent" cx="35" cy="11" r="2.3"></circle>
        <circle class="fill-accent" cx="35" cy="21" r="2.3"></circle>
      </svg>
      <span class={label}>Agent</span>
    </div>
    <div class="flex min-w-12 flex-1 flex-col gap-4 px-1.5" aria-hidden="true">
      <div class="relative h-[1.5px] bg-primary">
        <span
          class="absolute -right-px -top-[4.25px] h-0 w-0 border-y-[5px] border-l-8 border-y-transparent border-l-primary"
        ></span>
      </div>
      <div class="relative h-[1.5px] bg-primary">
        <span
          class="absolute -left-px -top-[4.25px] h-0 w-0 border-y-[5px] border-r-8 border-y-transparent border-r-primary"
        ></span>
      </div>
    </div>
    <div class={box}>
      <span class={label}>Environment</span>
      <svg class="hidden sm:block h-8 w-8" viewBox="0 0 34 34" aria-hidden="true">
        <circle class="fill-accent" cx="17" cy="17" r="16" opacity="0.15"></circle>
        <circle class="fill-accent" cx="17" cy="17" r="10" opacity="0.3"></circle>
        <circle class="fill-accent" cx="17" cy="17" r="4"></circle>
      </svg>
    </div>
  </div>

  <div class:list={['mx-auto h-9 w-[1.5px]', rail]} aria-hidden="true"></div>
  <div class:list={['mx-[12.5%] hidden h-[1.5px] md:block', rail]} aria-hidden="true"></div>
  <ul class="grid grid-cols-2 gap-y-6 md:grid-cols-4">
    {
      fields.map(({ label: fieldLabel, href }) => (
        <li class="flex flex-col items-center">
          <span class:list={['hidden h-6 w-[1.5px] md:block', rail]} aria-hidden="true" />
          <span class="h-2.5 w-2.5 rounded-full bg-primary" aria-hidden="true" />
          <a
            class="mt-3 font-heading text-lg md:text-xl font-medium text-heading hover:text-primary transition"
            href={href}
          >
            {fieldLabel}
          </a>
        </li>
      ))
    }
  </ul>
</figure>
