---
import Button from '~/components/ui/Button.astro';
import type { CallToAction } from '~/types';

// Hero over a live drawing: small vehicles whose light sensors are wired to the wheel on the
// opposite side, so that each turns towards the light, which follows the pointer (or drifts
// on its own, and carries on drifting from wherever the pointer leaves it). Where the drawing passes
// behind the words, it fades, so that it never gets in the way of reading them. The colours come
// from the site palette, so the drawing follows the light and dark themes. It stops while out of
// view, and visitors who ask for less motion get a still frame.

export interface Props {
  title?: string;
  subtitle?: string;
  actions?: Array<CallToAction>;
  id?: string;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  actions = [],
  id,
} = Astro.props;
---

<section
  class="relative md:-mt-[76px] not-prose overflow-hidden border-b border-gray-200 dark:border-slate-800"
  {...id ? { id } : {}}
>
  <vehicle-field class="absolute inset-0 block" aria-hidden="true">
    <canvas class="block h-full w-full"></canvas>
  </vehicle-field>
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pointer-events-none">
    <div class="pt-0 md:pt-[76px]"></div>
    <div class="flex min-h-[520px] md:min-h-[600px] flex-col justify-end pt-16 pb-16 md:pb-20">
      <h1
        class="font-heading font-bold text-heading text-5xl md:text-6xl leading-none tracking-tighter"
        set:html={title}
      />
      {subtitle && <p class="mt-7 max-w-xl text-lg md:text-xl text-muted" set:html={subtitle} />}
      {
        actions.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3 pointer-events-auto">
            {actions.map((action) => (
              <Button {...action} />
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  interface Vehicle {
    x: number;
    y: number;
    heading: number;
    size: number;
    trail: Array<number>;
  }

  // The light's drift along one axis: a swing about a centre, as fractions of the width or the
  // height. Its phase and reach are kept from frame to frame, so that the swing can start again
  // from any point. A reach wider than the usual amplitude shrinks back to it slowly, and the
  // light keeps its usual speed meanwhile.
  interface Swing {
    centre: number;
    amplitude: number;
    /** Radians per millisecond. */
    speed: number;
    phase: number;
    reach: number;
  }

  const swings = (): [Swing, Swing] => [
    { centre: 0.62, amplitude: 0.25, speed: 0.00031, phase: 0, reach: 0.25 },
    { centre: 0.45, amplitude: 0.3, speed: 0.00047, phase: 1.3, reach: 0.3 },
  ];

  class VehicleField extends HTMLElement {
    private canvas!: HTMLCanvasElement;
    private ctx!: CanvasRenderingContext2D;
    private target!: HTMLElement;
    private vehicles: Array<Vehicle> = [];
    private width = 0;
    private height = 0;
    private pointer: { x: number; y: number } | null = null;
    /** Which way the pointer was going, smoothed over its last moves. */
    private pointerHeading = { x: 0, y: 0 };
    private drift = swings();
    private lastTime?: number;
    /** The boxes of the words over the drawing, in canvas pixels. */
    private words: Array<{ left: number; top: number; right: number; bottom: number }> = [];
    private frame = 0;
    private running = false;
    private colours = { background: '#081a22', line: '#4fb1ba', light: '#f2c46b' };
    private still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    private resizeObserver?: ResizeObserver;
    private visibilityObserver?: IntersectionObserver;
    private themeObserver?: MutationObserver;

    connectedCallback() {
      const canvas = this.querySelector('canvas');
      const ctx = canvas?.getContext('2d');
      if (!canvas || !ctx) return;
      this.canvas = canvas;
      this.ctx = ctx;
      this.target = this.parentElement ?? this;
      this.readColours();
      this.resize();
      // The words move once the site's fonts have loaded.
      document.fonts?.ready.then(() => {
        this.measureWords();
        if (this.still) this.renderStill();
      });
      this.target.addEventListener('pointermove', this.onMove);
      this.target.addEventListener('pointerleave', this.onLeave);
      this.resizeObserver = new ResizeObserver(() => this.resize());
      this.resizeObserver.observe(this);
      this.themeObserver = new MutationObserver(() => {
        this.readColours();
        if (this.still) this.renderStill();
      });
      this.themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      if (this.still) {
        this.renderStill();
        return;
      }
      this.visibilityObserver = new IntersectionObserver(([entry]) =>
        entry.isIntersecting ? this.start() : this.stop()
      );
      this.visibilityObserver.observe(this);
    }

    disconnectedCallback() {
      this.stop();
      this.resizeObserver?.disconnect();
      this.visibilityObserver?.disconnect();
      this.themeObserver?.disconnect();
      this.target?.removeEventListener('pointermove', this.onMove);
      this.target?.removeEventListener('pointerleave', this.onLeave);
    }

    private readColours() {
      const style = getComputedStyle(document.documentElement);
      const read = (name: string, fallback: string) => style.getPropertyValue(name).trim() || fallback;
      this.colours = {
        background: read('--aw-color-bg-page', this.colours.background),
        line: read('--aw-color-primary', this.colours.line),
        light: read('--aw-color-accent', this.colours.light),
      };
    }

    private resize() {
      const rect = this.canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      this.width = Math.max(1, rect.width);
      this.height = Math.max(1, rect.height);
      this.canvas.width = Math.round(this.width * dpr);
      this.canvas.height = Math.round(this.height * dpr);
      this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      this.measureWords();
      if (!this.vehicles.length && this.width > 10) this.seed();
      // Resizing clears the canvas: the animation redraws on its next frame, a still frame is redrawn now.
      if (this.still && this.width > 10) this.renderStill();
    }

    /** Each line of the title and the text, and each button, as a box. */
    private measureWords() {
      const origin = this.canvas.getBoundingClientRect();
      const boxes: Array<DOMRect> = [];
      this.target.querySelectorAll<HTMLElement>('h1, p, a').forEach((element) => {
        if (element.tagName === 'A') {
          boxes.push(element.getBoundingClientRect());
          return;
        }
        const range = document.createRange();
        range.selectNodeContents(element);
        boxes.push(...Array.from(range.getClientRects()));
      });
      this.words = boxes
        .filter((box) => box.width > 0 && box.height > 0)
        .map((box) => ({
          left: box.left - origin.left,
          top: box.top - origin.top,
          right: box.right - origin.left,
          bottom: box.bottom - origin.top,
        }));
    }

    /** How far a point is behind the words: 1 on them, easing to 0 at 40 pixels from them. */
    private veil(x: number, y: number) {
      let nearest = Infinity;
      for (const word of this.words) {
        const dx = Math.max(word.left - x, 0, x - word.right);
        const dy = Math.max(word.top - y, 0, y - word.bottom);
        nearest = Math.min(nearest, Math.hypot(dx, dy));
        if (nearest === 0) break;
      }
      const t = Math.max(0, 1 - Math.max(0, nearest - 6) / 34);
      return t * t * (3 - 2 * t);
    }

    private seed() {
      this.drift = swings();
      this.lastTime = undefined;
      const count = Math.max(4, Math.min(9, Math.round(this.width / 170)));
      this.vehicles = Array.from({ length: count }, () => ({
        x: Math.random() * this.width,
        y: Math.random() * this.height,
        heading: Math.random() * Math.PI * 2,
        size: 0.8 + Math.random() * 0.5,
        trail: [],
      }));
    }

    private start() {
      if (this.running) return;
      this.running = true;
      const loop = (t: number) => {
        if (!this.running) return;
        this.render(t);
        this.frame = requestAnimationFrame(loop);
      };
      this.frame = requestAnimationFrame(loop);
    }

    private stop() {
      this.running = false;
      cancelAnimationFrame(this.frame);
    }

    private renderStill() {
      this.seed();
      for (let k = 0; k < 240; k++) this.render(k * 16);
    }

    private onMove = (event: PointerEvent) => {
      const rect = this.canvas.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      if (this.pointer) {
        this.pointerHeading = {
          x: 0.7 * this.pointerHeading.x + 0.3 * (x - this.pointer.x),
          y: 0.7 * this.pointerHeading.y + 0.3 * (y - this.pointer.y),
        };
      }
      this.pointer = { x, y };
    };

    // The drift starts again where the pointer left the light, heading the way the pointer went.
    private onLeave = () => {
      if (this.pointer) {
        const [across, down] = this.drift;
        this.restart(across, this.pointer.x / this.width, this.pointerHeading.x);
        this.restart(down, this.pointer.y / this.height, this.pointerHeading.y);
      }
      this.pointer = null;
      this.pointerHeading = { x: 0, y: 0 };
    };

    /** Puts a swing at `at`, moving the way of `heading` (towards its centre if there is none). */
    private restart(swing: Swing, at: number, heading: number) {
      const offset = at - swing.centre;
      swing.reach = Math.max(swing.amplitude, Math.abs(offset));
      const sine = Math.asin(Math.max(-1, Math.min(1, offset / swing.reach)));
      const direction = Math.abs(heading) > 0.5 ? heading : -offset;
      swing.phase = direction >= 0 ? sine : Math.PI - sine;
    }

    /** The light: the pointer, or else the drift, moved on by `dt` milliseconds. */
    private light(dt: number) {
      if (this.pointer) return this.pointer;
      for (const swing of this.drift) {
        swing.phase += swing.speed * (swing.amplitude / swing.reach) * dt;
        swing.reach += (swing.amplitude - swing.reach) * (1 - Math.exp(-dt / 8000));
      }
      const [across, down] = this.drift;
      return {
        x: this.width * (across.centre + across.reach * Math.sin(across.phase)),
        y: this.height * (down.centre + down.reach * Math.sin(down.phase)),
      };
    }

    /** Light intensity at a point: falls off with the squared distance. */
    private intensity(px: number, py: number, l: { x: number; y: number }) {
      const dx = px - l.x;
      const dy = py - l.y;
      return 1 / (1 + (dx * dx + dy * dy) / 60000);
    }

    private step(v: Vehicle, l: { x: number; y: number }) {
      const spread = 0.55;
      const reach = 14 * v.size;
      const left = this.intensity(
        v.x + Math.cos(v.heading - spread) * reach,
        v.y + Math.sin(v.heading - spread) * reach,
        l
      );
      const right = this.intensity(
        v.x + Math.cos(v.heading + spread) * reach,
        v.y + Math.sin(v.heading + spread) * reach,
        l
      );
      // Crossed wiring: each sensor drives the wheel on the other side.
      const leftWheel = 0.5 + 3 * right;
      const rightWheel = 0.5 + 3 * left;
      const axle = 18 * v.size;
      // Screen coordinates (y down): a faster left wheel turns the vehicle clockwise.
      v.heading += ((leftWheel - rightWheel) / axle) * 10 + (Math.random() - 0.5) * 0.02;
      const speed = Math.min(2.6, (leftWheel + rightWheel) / 2);
      v.x += Math.cos(v.heading) * speed;
      v.y += Math.sin(v.heading) * speed;
      let wrapped = false;
      if (v.x < -20) [v.x, wrapped] = [this.width + 20, true];
      if (v.x > this.width + 20) [v.x, wrapped] = [-20, true];
      if (v.y < -20) [v.y, wrapped] = [this.height + 20, true];
      if (v.y > this.height + 20) [v.y, wrapped] = [-20, true];
      if (wrapped) v.trail = [];
      v.trail.push(v.x, v.y);
      if (v.trail.length > 160) v.trail.splice(0, 2);
    }

    private drawTrail(v: Vehicle) {
      const { ctx } = this;
      const n = v.trail.length / 2;
      ctx.strokeStyle = this.colours.line;
      ctx.lineWidth = 1;
      for (let i = 1; i < n; i++) {
        ctx.globalAlpha = 0.45 * (i / n) * (1 - 0.85 * this.veil(v.trail[2 * i], v.trail[2 * i + 1]));
        ctx.beginPath();
        ctx.moveTo(v.trail[2 * i - 2], v.trail[2 * i - 1]);
        ctx.lineTo(v.trail[2 * i], v.trail[2 * i + 1]);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }

    private drawVehicle(v: Vehicle) {
      const { ctx } = this;
      const s = v.size;
      ctx.save();
      ctx.globalAlpha = 1 - 0.8 * this.veil(v.x, v.y);
      ctx.translate(v.x, v.y);
      ctx.rotate(v.heading);
      ctx.lineWidth = 1.2;
      ctx.strokeStyle = this.colours.line;
      ctx.fillStyle = this.colours.background;
      ctx.beginPath();
      ctx.rect(-11 * s, -7 * s, 22 * s, 14 * s);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = this.colours.line;
      ctx.fillRect(-9.5 * s, -10 * s, 8 * s, 2.5 * s);
      ctx.fillRect(-9.5 * s, 7.5 * s, 8 * s, 2.5 * s);
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      ctx.moveTo(9.5 * s, -4 * s);
      ctx.lineTo(-5.5 * s, 7 * s);
      ctx.moveTo(9.5 * s, 4 * s);
      ctx.lineTo(-5.5 * s, -7 * s);
      ctx.stroke();
      ctx.fillStyle = this.colours.light;
      ctx.beginPath();
      ctx.arc(11 * s, -4 * s, 1.8 * s, 0, Math.PI * 2);
      ctx.arc(11 * s, 4 * s, 1.8 * s, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    private drawLight(l: { x: number; y: number }) {
      const { ctx } = this;
      const strength = 1 - 0.6 * this.veil(l.x, l.y);
      ctx.fillStyle = this.colours.light;
      for (const [radius, alpha] of [
        [46, 0.05],
        [24, 0.1],
        [10, 0.22],
      ]) {
        ctx.globalAlpha = alpha * strength;
        ctx.beginPath();
        ctx.arc(l.x, l.y, radius, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = strength;
      ctx.beginPath();
      ctx.arc(l.x, l.y, 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalAlpha = 1;
    }

    private render(t: number) {
      // A long gap (the drawing was out of view) moves the light on by one frame only.
      const dt = this.lastTime === undefined ? 16 : Math.min(50, Math.max(0, t - this.lastTime));
      this.lastTime = t;
      const l = this.light(dt);
      this.ctx.fillStyle = this.colours.background;
      this.ctx.fillRect(0, 0, this.width, this.height);
      for (const v of this.vehicles) {
        this.step(v, l);
        this.drawTrail(v);
      }
      for (const v of this.vehicles) this.drawVehicle(v);
      this.drawLight(l);
    }
  }

  if (!customElements.get('vehicle-field')) customElements.define('vehicle-field', VehicleField);
</script>
