---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import type { Item } from '~/types';

// An item may hold items of its own, which are drawn inside it as a timeline of their own.
type TimelineItem = Item & { items?: Array<Item> };

export interface Props {
  items?: Array<TimelineItem>;
  defaultIcon?: string;
  /** `step` is the space under each item but the last. */
  classes?: Record<string, string>;
  /** The classes of the timelines inside items. */
  subClasses?: Record<string, string>;
}

const { items = [], classes = {}, subClasses = classes, defaultIcon } = Astro.props as Props;

const {
  container: containerClass = '',
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = 'text-primary dark:text-slate-200 border-primary/40 dark:border-primary/60',
  step: stepClass = 'pb-8',
} = classes;
---

{
  items && items.length > 0 && (
    <div class={containerClass}>
      {items.map(({ title, description, icon, classes: itemClasses = {}, items: subItems = [] }, index = 0) => (
        <div
          class={twMerge(
            'flex intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
            panelClass,
            itemClasses?.panel
          )}
        >
          <div class="flex flex-col items-center mr-4 rtl:mr-0 rtl:ml-4">
            <div>
              <div class="flex items-center justify-center">
                {(icon || defaultIcon) && (
                  <Icon
                    name={icon || defaultIcon}
                    class={twMerge('w-10 h-10 p-2 rounded-full border-2', defaultIconClass, itemClasses?.icon)}
                  />
                )}
              </div>
            </div>
            {index !== items.length - 1 && <div class="w-px h-full bg-black/10 dark:bg-slate-400/50" />}
          </div>
          <div class={twMerge('pt-1', index !== items.length - 1 && stepClass)}>
            {title && <p class={twMerge('text-xl font-bold', titleClass, itemClasses?.title)} set:html={title} />}
            {description && (
              <p
                class={twMerge('text-muted mt-2', descriptionClass, itemClasses?.description)}
                set:html={description}
              />
            )}
            {subItems.length > 0 && <Astro.self items={subItems} defaultIcon={defaultIcon} classes={subClasses} />}
          </div>
        </div>
      ))}
    </div>
  )
}
